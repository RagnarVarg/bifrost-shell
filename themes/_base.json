{
  "id": "_base",
  "name": "Bifrost base tokens",
  "_comment": "Structural tokens shared by all themes. Themes override palette/opacity/materials per variant. Colours are opaque #RRGGBB; translucency is expressed as { color, alpha } and resolved centrally. '@a.b' references another token.",
