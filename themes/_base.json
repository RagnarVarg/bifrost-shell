  "textShadow": {
    "_comment": "Soft shadow under text laid directly over a picture (the login screen's date): readable over light areas, no glow or outline.",
    "blur": 0.6,
    "blurMax": 10,
    "opacity": 0.6,
    "offsetY": 1
  },
  "glass": {
    "_comment": "Bifrost standard glass, approved 2026-09-24 ('thick, clear glass', from the gallery's 'Tjockt' variant and the user's own tuning). The tint is light so the desktop stays visible; thickness comes from depth (darker toward the bottom), density (more opaque toward the bottom, clearest at the top edge), a clear top highlight and a thin silver rim. grain is barely visible on purpose. edgeTopBias = how much brighter the rim is at the top. bevel/bevelStrength = the bevelled inner edge at thickness 1 (px, light strength); refraction = default colour split along it (0 = none). Settings → Glass & materials scales all of this per surface.",
    "tint": "@palette.base",
    "blur": true,
    "grain": 0.012,
    "highlight": 0.06,
    "highlightColor": "@palette.silverBright",
    "depth": 0.36,
    "density": 0.32,
    "sheen": 0.02,
    "edgeTopBias": 0.5,
    "bevel": 3,
    "bevelStrength": 0.08,
    "refraction": 0.0,
    "_blurMask": "Compositor blur follows the glass through its alpha: Hyprland blurs a Bifrost layer only where the surface's alpha is above ignore_alpha (bifrostctl writes these values). Clean glass: the tiny threshold. Glass that draws a shadow or glow outside itself: the higher one, and the shader keeps the body above it and everything outside below it, so no blur shows past the rounded corners.",
    "blurMask": 0.01,
    "blurMaskShadowed": 0.12,
    "_windowRadiusMax": "Largest corner radius Hyprland can clip an app window to (window rule 'rounding' is at most 20). Glass drawn as a whole app window (Settings) is capped to it, so its blur, tint and border keep one shape.",
    "windowRadiusMax": 20
  },
  "materials": {
    "bar": {
      "tint": "@glass.tint",
      "opacity": 0.48,
      "blur": "@glass.blur",
      "radius": "@radius.lg",
      "grain": "@glass.grain",
      "highlight": "@glass.highlight",
      "highlightColor": "@glass.highlightColor",
      "innerBorder": "@color.innerBorder",
      "outerBorder": "@color.outerBorder",
      "borderWidth": "@border.material",
      "elevation": "@elevation.low",
      "depth": "@glass.depth",
      "sheen": "@glass.sheen",
      "edgeTopBias": "@glass.edgeTopBias",
      "density": "@glass.density"
    },
    "dock": {
      "tint": "@glass.tint",
      "opacity": 0.46,
      "blur": "@glass.blur",
      "radius": "@radius.xl",
      "grain": "@glass.grain",
      "highlight": "@glass.highlight",
      "highlightColor": "@glass.highlightColor",
      "innerBorder": "@color.innerBorder",
      "outerBorder": "@color.outerBorder",
      "borderWidth": "@border.material",
      "elevation": "@elevation.mid",
