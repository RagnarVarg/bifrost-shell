      "workspaces": "#4F7FA0",
      "launcher": "#5574B8",
      "dock": "#5E86A8",
      "controlCenter": "#6E7A90",
      "osd": "#8C6E9E",
      "notifications": "#B5615F",
      "lock": "#6B7280",
      "greeter": "#5C6A80",
      "power": "#A65D5D",
      "clock": "#B48A4E",
      "systemStats": "#5E8F74",
      "keybinds": "#68707E",
      "keybinds/shortcuts": "#68707E",
      "displays": "#4F78C4",
      "monitors": "#4F78C4",
      "hyprland": "#56729A",
      "input": "#707A88",
      "input/keyboard": "#68707E",
      "input/gestures": "#B07A55",
      "input/mouse": "#5E86A8",
      "input/trackpad": "#6A6FB8",
      "network": "#4E82B8",
      "bluetooth": "#4E6FC0",
      "profiles": "#7A7E58",
      "transfer": "#5F8C86",
      "data": "#5E6672"
    }
