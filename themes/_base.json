      "opacity": 0.58,
      "blur": "@glass.blur",
      "radius": "@radius.lg",
      "grain": "@glass.grain",
      "highlight": "@glass.highlight",
      "highlightColor": "@glass.highlightColor",
      "innerBorder": "@color.innerBorder",
