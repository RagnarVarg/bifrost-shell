    "sidebarWideWidth": 240,
    "pageWideMaxWidth": 720,
    "sidebarWidth": 220,
    "pageMaxWidth": 680,
    "editorWidth": 300,
    "_settingsEditorWidth": "Width of a control in a Settings row (the row's right column).",
    "settingsEditorWidth": 260,
