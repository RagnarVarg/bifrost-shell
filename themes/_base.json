    "tileIcon": "#FFFFFF",
    "tile": {
      "fallback": "#5F6878",
      "appearance": "#7E6BB0",
      "wallpaper": "#4F8E95",
      "materials": "#5B7FA6",
      "apps": "#4E77B5",
      "effects": "#9A6A9C",
      "typography": "#6A6FB8",
      "motion": "#B07A55",
      "themeBrowser": "#8A6FB8",
