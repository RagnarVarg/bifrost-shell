  "effects": {
    "_comment": "Bifrost Effects (Settings → Appearance → Bifrost Effects). The bar's effects strengthen its glass material (the shader draws them along the real shape): highlight adds to the inner rim, the edge to the dark outer hairline, the prism becomes refraction in the prism colours (cyan → blue → violet, toned by Prism Saturation; prismRefraction = refraction per unit of Prism Strength), the gradient adds to the top light and the depth. capsule*/divider* = the centre capsule and section dividers. windowInnerRange = Hyprland inner-glow width (px) for the windows' inner highlight; inactiveShare = how much of an active-window effect an inactive window keeps; windowPrismShare = share of the border height the prism takes at the top.",
    "prism": ["#5CC8DC", "#6A8BEE", "#9B7DE6"],
    "highlightColor": "@glass.highlightColor",
    "edgeColor": "@palette.void",
    "dividerColor": "@color.text",
    "dividerOpacity": 0.14,
    "dividerLength": 0.42,
    "lineWidth": 1,
    "prismRefraction": 2,
    "capsuleFill": 0.05,
    "capsuleBorder": 0.1,
    "capsulePadding": "@space.sm",
    "windowInnerRange": 2,
    "windowPrismShare": 0.2,
    "inactiveShare": 0.35
  },
  "prism": {
    "_comment": "Bifrost refraction look for selected/active/focus. tint = how far the fill leans toward the aurora stops, caustic = soft split-light line under the top edge, edge = rim strength, dispersion = how much the rim hue shifts around the perimeter, driftSeconds = slow hue drift period (0 = static).",
    "enabled": true,
    "stops": "@palette.aurora",
    "angle": 115,
    "spread": 0.6,
    "edgeWidth": 1,
    "tint": 0.36,
    "caustic": 0.14,
    "edge": 0.62,
    "dispersion": 0.7,
    "driftSeconds": 0,
    "intensity": {
      "hover": 0.3,
      "selected": 0.6,
      "active": 0.8,
      "focus": 0.5
    }
  },
  "lit": {
    "_comment": "Lit look for selected/active items (appearance.selection = lit): the colour lit from within, no halo. fill = fill opacity per state, highlight = how much lighter the top is, rim = opacity of the light inner rim, rimLight = how much lighter the rim is than the colour, light = the light mixed in.",
    "fill": {
      "selected": 0.55,
      "active": 0.75
    },
    "highlight": 0.35,
    "rim": 0.6,
    "rimLight": 0.5,
    "light": "#FFFFFF"
  },
