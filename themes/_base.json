    "settingsSegmentChars": 26,
    "popupMaxHeight": 320,
    "launcherWidth": 900,
    "launcherHeight": 620,
    "controlCenterWidth": 392,
    "clockMenuWidth": 560,
    "dayPanelWidth": 320,
    "workspacePreviewWidth": 440,
    "themePreviewAspect": 2.6,
    "_overview": "Overview (all windows): a picture is at most overviewTileHeight × the screen's height tall and overviewTileAspect × that wide (fewer windows never make them bigger), with overviewGap between them.",
