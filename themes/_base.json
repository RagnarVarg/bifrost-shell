    "outerBorder": {
      "color": "@palette.void",
      "alpha": "@opacity.outerBorder"
    },
    "scrim": {
      "color": "@palette.void",
      "alpha": "@opacity.scrim"
    },
    "overviewScrim": {
      "color": "@palette.void",
      "alpha": "@opacity.overviewScrim"
    },
    "shadow": "@palette.void",
    "textOnGlass": "@palette.text",
    "icon": "@palette.silver",
    "iconMuted": "@palette.textMuted",
    "track": {
