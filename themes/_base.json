    "xxs": 2,
    "xs": 3,
    "sm": 5,
    "md": 7,
    "lg": 10,
    "xl": 14,
    "xxl": 20,
    "xxxl": 28
  },
  "radius": {
    "xs": 3,
    "sm": 5,
    "md": 8,
    "lg": 10,
    "xl": 14,
    "menu": 22,
    "full": 9999
  },
  "border": {
    "hairline": 1,
    "material": 1,
    "thick": 2,
    "focus": 2
  },
  "opacity": {
    "hairline": 0.1,
    "innerBorder": 0.16,
    "outerBorder": 0.5,
    "disabled": 0.38,
    "scrim": 0.45,
    "overviewScrim": 0.86,
    "stateHover": 0.055,
    "statePressed": 0.1,
    "stateSelected": 0.14,
    "stateActive": 0.2,
    "track": 0.16,
    "controlFill": 0.06,
    "fieldFill": 0.3,
    "divider": 0.08
  },
  "elevation": {
    "none": {
      "blur": 0,
      "y": 0,
      "spread": 0,
      "opacity": 0
    },
    "low": {
      "blur": 10,
      "y": 2,
      "spread": 0,
      "opacity": 0.18
    },
    "mid": {
      "blur": 20,
      "y": 6,
      "spread": 0,
      "opacity": 0.24
    },
    "high": {
      "blur": 32,
      "y": 12,
      "spread": 0,
      "opacity": 0.3
    }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 100,
      "normal": 180,
      "slow": 290,
      "emphasis": 420
    },
    "easing": {
      "standard": [
        0.2,
        0.0,
        0.0,
        1.0
      ],
      "decelerate": [
        0.0,
        0.0,
        0.0,
        1.0
      ],
      "accelerate": [
        0.3,
        0.0,
        1.0,
        1.0
      ],
      "emphasized": [
        0.05,
        0.7,
        0.1,
        1.0
      ],
      "linear": [
        0.0,
        0.0,
        1.0,
        1.0
      ]
    }
  },
  "font": {
    "ui": "Inter",
    "mono": "Geist Mono",
    "size": {
      "xs": 10,
      "sm": 11,
      "md": 12,
      "lg": 14,
      "xl": 17,
      "xxl": 21,
      "display": 30,
      "hero": 88
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacing": {
      "tight": -0.2,
      "normal": 0,
      "wide": 0.6
    },
    "runic": "Noto Sans Runic"
  },
  "color": {
    "bg": "@palette.base",
    "surface": "@palette.surface",
    "surfaceRaised": "@palette.surfaceRaised",
    "text": "@palette.text",
    "textMuted": "@palette.textMuted",
