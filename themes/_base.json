      "alpha": "@opacity.controlFill"
    },
    "fieldFill": {
      "color": "@palette.void",
      "alpha": "@opacity.fieldFill"
    },
    "divider": {
      "color": "@palette.silver",
      "alpha": "@opacity.divider"
    },
