# Bifrost Shell as the session shell. Installed by install.sh, which replaces
# @EXEC@ with the installed bin/bifrost-shell. Conflicts with other shells so
# only one owns the session.
[Unit]
Description=Bifrost Shell
Documentation=man:systemd.service(5)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
Conflicts=dms.service

[Service]
Type=simple
Environment=BIFROST_RUN_MODE=production
ExecStart=@EXEC@
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
