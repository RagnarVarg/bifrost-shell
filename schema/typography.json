{
  "section": "typography",
  "label": "Fonts & icons",
  "icon": "type",
  "groups": {
    "fonts": "Fonts",
    "icons": "Icons"
  },
  "settings": [
    {
      "key": "appearance.font.ui",
      "type": "font",
      "default": null,
      "nullable": true,
      "label": "UI font",
      "description": "Empty = the theme's (Geist)",
      "group": "fonts",
      "inherit": "font.ui"
    },
    {
      "key": "appearance.font.mono",
      "type": "font",
      "default": null,
      "nullable": true,
      "label": "Monospace",
      "description": "For technical information. Empty = the theme's (Geist Mono)",
      "group": "fonts",
      "inherit": "font.mono"
    },
    {
      "key": "appearance.font.scale",
      "type": "real",
      "default": 1.0,
      "min": 0.75,
      "max": 1.5,
      "step": 0.05,
      "label": "Text size",
      "group": "fonts"
    },
    {
      "key": "appearance.icons.theme",
      "type": "icon",
      "default": null,
      "nullable": true,
      "label": "App icon theme",
      "description": "Empty = Bifrost default: Gruvbox-Plus-Dark-IceBlue-FullBlue. System = the desktop's icon theme",
      "group": "icons",
      "apply": "live",
      "editor": "IconThemeEditor"
    }
  ]
}
