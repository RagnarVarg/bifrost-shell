{
  "section": "materials",
  "label": "Glass & transparency",
  "icon": "layers",
  "description": "The glass of every Bifrost surface. With Same glass everywhere on, every part uses the values under All; switch it off to give the top bar, widgets, panels, control center and Bifrost windows their own. Application windows always have their own.",
  "settings": [
    {
      "key": "materials.transparency",
      "type": "int",
      "default": null,
      "nullable": true,
      "min": 0,
      "max": 100,
      "unit": "%",
      "label": "Transparency",
      "description": "0 % = solid, 100 % = fully clear (only the border and blur remain). Standard = the theme's glass, tuned per surface and for light and dark",
      "nullLabel": "Standard",
      "inherit": "materials.panel.transparency",
      "group": "all"
    },
    {
      "key": "materials.blur",
      "type": "int",
      "default": 20,
      "min": 0,
      "max": 100,
      "unit": "%",
      "label": "Background blur",
      "description": "Blurs what is behind the glass. 0 = off",
      "scope": "hyprland",
      "requires": {
        "capability": "surfaceBlur"
      },
      "group": "all"
    },
