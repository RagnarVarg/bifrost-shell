{
  "section": "materials",
  "label": "Glass & transparency",
  "icon": "layers",
  "description": "The glass of every Bifrost surface. With Same glass everywhere on, every part uses the values under All; switch it off to give the top bar, widgets, panels, the control center's buttons and Bifrost windows their own. The control center grows out of its button and shares its glass. Application windows always have their own. Transparency, blur and colours are kept separately for light and dark mode: you change the mode you're in.",
  "settings": [
    {
      "key": "materials.transparency",
      "type": "int",
      "default": null,
      "nullable": true,
      "min": 0,
      "max": 100,
      "unit": "%",
      "label": "Transparency",
      "description": "0 % = solid, 100 % = fully clear (only the border and blur remain). Standard = the theme's glass, tuned per surface and for light and dark",
      "nullLabel": "Standard",
      "inherit": "materials.panel.transparency",
      "group": "all",
      "perMode": true
    },
    {
      "key": "materials.blur",
      "type": "int",
      "default": 20,
      "min": 0,
      "max": 100,
      "unit": "%",
      "label": "Background blur",
      "description": "Blurs what is behind the glass. 0 = off",
      "scope": "hyprland",
      "requires": {
        "capability": "surfaceBlur"
      },
      "group": "all",
      "perMode": true
    },
    {
      "key": "materials.tint",
      "type": "color",
      "default": null,
      "nullable": true,
      "label": "Tint",
      "description": "Colour of the glass. Empty = the theme's colour",
      "nullLabel": "Theme",
      "inherit": "materials.panel.tint",
      "group": "all",
      "perMode": true
    },
    {
      "key": "materials.border",
      "type": "bool",
      "default": true,
      "label": "Border",
      "description": "A thin outline around the glass",
      "group": "all"
    },
