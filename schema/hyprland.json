{
  "section": "hyprland",
  "label": "Windows & compositor",
  "icon": "windows",
  "description": "Settings for ordinary application windows, applied live to Hyprland through Bifrost's generated bifrost.lua. They never affect Bifrost's own panels (see Glass & materials).",
  "groups": {
    "general": "General",
    "layout": "Layout",
    "decoration": "Border & corners",
    "windows": "Window transparency",
    "integration": "Integration"
  },
  "requires": {
    "compositor": [
      "hyprland"
    ]
  },
  "settings": [
    {
      "key": "hyprland.manage",
      "type": "bool",
      "default": true,
      "label": "Let Bifrost manage window appearance",
      "description": "Off = Bifrost leaves gaps, borders, corners, window transparency and blur to your own Hyprland config",
      "group": "general",
      "scope": "hyprland"
    },
    {
      "key": "hyprland.gapsIn",
      "type": "int",
      "default": 6,
      "min": 0,
      "max": 40,
      "unit": "px",
      "label": "Gaps between windows",
      "group": "layout",
      "scope": "hyprland",
      "dependsOn": "hyprland.manage"
    },
    {
      "key": "hyprland.gapsOut",
      "type": "int",
      "default": 12,
      "min": 0,
      "max": 80,
      "unit": "px",
      "label": "Gaps to screen edges",
      "group": "layout",
      "scope": "hyprland",
      "dependsOn": "hyprland.manage"
    },
    {
      "key": "hyprland.borderSize",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 12,
      "unit": "px",
      "label": "Window border",
      "description": "Width of the border around application windows",
      "group": "decoration",
      "scope": "hyprland",
      "dependsOn": "hyprland.manage"
    },
    {
      "key": "hyprland.activeBorderColor",
      "type": "color",
      "default": null,
      "nullable": true,
      "inherit": "palette.accent",
      "label": "Active window border colour",
      "description": "Colour of the focused application window border. Empty = theme accent.",
      "group": "decoration",
      "scope": "hyprland",
      "dependsOn": "hyprland.manage"
    },
    {
      "key": "hyprland.inactiveBorderColor",
      "type": "color",
      "default": null,
      "nullable": true,
      "inherit": "palette.surfaceRaised",
      "label": "Inactive window border colour",
      "description": "Colour of unfocused application window borders. Empty = theme default.",
      "group": "decoration",
      "scope": "hyprland",
      "dependsOn": "hyprland.manage"
    },
    {
      "key": "hyprland.rounding",
      "type": "int",
      "default": null,
      "nullable": true,
      "min": 0,
      "max": 40,
      "unit": "px",
      "label": "Window corner radius",
      "description": "Empty = follow the Bifrost theme",
      "group": "decoration",
      "scope": "hyprland",
      "dependsOn": "hyprland.manage",
      "inherit": "radius.lg"
    },
    {
      "key": "hyprland.windows.activeTransparency",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 60,
      "unit": "%",
      "label": "Active window transparency",
      "description": "0 = opaque. Applies to application windows only",
      "group": "windows",
      "scope": "hyprland",
      "dependsOn": "hyprland.manage"
    },
    {
      "key": "hyprland.windows.inactiveTransparency",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 60,
      "unit": "%",
      "label": "Inactive window transparency",
      "group": "windows",
      "scope": "hyprland",
      "dependsOn": "hyprland.manage"
    },
    {
      "key": "hyprland.layerRules",
      "type": "bool",
      "default": true,
      "label": "Compositor rules for Bifrost surfaces",
      "description": "Blur behind Bifrost panels and no compositor animation on them",
      "group": "integration",
      "scope": "hyprland",
      "advanced": true
    }
  ]
}
