# Settings calls these through bifrostctl so the logic exists only once.
BUNDLE_FORMAT = "bifrost-bundle"


def now_iso():
    import datetime
    return datetime.datetime.now().replace(microsecond=0).isoformat()


def write_json_atomic(path: Path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix="." + path.name + ".", suffix=".tmp")
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    os.replace(tmp, path)


def backup_config(reason: str) -> Path | None:
    src = config_file()
    if not src.exists():
        return None
    stamp = now_iso().replace(":", "")
    dst = config_dir() / "backups" / f"config.{reason}.{stamp}.json"
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(src.read_text())
    return dst


def flatten(tree, prefix=""):
    out = {}
    if isinstance(tree, dict):
        for k, v in tree.items():
            path = f"{prefix}.{k}" if prefix else k
            if isinstance(v, dict) and not path_is_leaf(path):
                out.update(flatten(v, path))
            else:
                out[path] = v
    return out


_LEAF_KEYS: set[str] = set()


def path_is_leaf(path):
    return path in _LEAF_KEYS


def diff_values(schema, current: dict, incoming: dict):
    """Changes as [(key, old, new)] for keys the incoming tree sets."""
    global _LEAF_KEYS
    _LEAF_KEYS = set(schema.entries)
    changes = []
    for key, new in flatten(incoming).items():
        old, _ = deep_get(current, key)
        if not same(old, new):
            changes.append((key, old, new))
    return changes


def apply_values(cfg, values: dict, preset=None, replace=True):
    """Validates and writes values into config.json (replacing or merging)."""
    doc = cfg.doc
    if replace:
        doc["values"] = {}
    problems = []
    global _LEAF_KEYS
    _LEAF_KEYS = set(cfg.schema.entries)
    for key, raw in flatten(values).items():
        d = cfg.schema.entries.get(key)
        if not d:
            deep_set(doc["values"], key, raw)       # keep unknown keys, like the shell does
            problems.append(f"{key}: unknown (kept)")
            continue
        ok, v, err = coerce(d, raw)
        if ok:
            deep_set(doc["values"], key, v)
        else:
            problems.append(err)
    if preset is not None:
        if preset and preset != "default":
            doc["preset"] = preset
        else:
            doc.pop("preset", None)
    cfg.save()
    return problems


# profiles
def profiles_dir() -> Path:
    return config_dir() / "profiles"


def profile_path(name: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9._ -]", "", name).strip()
    if not safe:
        raise SystemExit("invalid profile name")
    return profiles_dir() / f"{safe}.json"


def list_profiles():
    out = []
    for f in sorted(profiles_dir().glob("*.json")):
        try:
            d = json.loads(f.read_text())
        except json.JSONDecodeError:
            continue
        out.append({"name": d.get("name", f.stem), "file": str(f), "created": d.get("created", ""),
                    "preset": d.get("preset", "default"), "count": len(flatten(d.get("values", {})))})
    return out


# presets
def list_presets():
    seen, out = set(), []
    for d in (config_dir() / "presets", REPO / "presets"):
        for f in sorted(d.glob("*.json")):
            if f.stem in seen:
                continue
            seen.add(f.stem)
            data = json.loads(f.read_text())
            out.append({"id": f.stem, "name": data.get("name", f.stem), "description": data.get("description", ""),
                        "user": d != REPO / "presets"})
    return [{"id": "default", "name": "Standard", "description": "Inga preset-värden", "user": False}] + out


# bundles
def export_bundle(cfg, path: Path | None):
    theme_id, _ = deep_get(cfg.values, "appearance.theme")
    bundle = {"format": BUNDLE_FORMAT, "version": 1, "created": now_iso(),
              "preset": cfg.doc.get("preset", "default"), "values": cfg.doc.get("values", {}), "themes": {}}
    user_theme = config_dir() / "themes" / f"{theme_id}.json"
    if user_theme.exists():
        bundle["themes"][theme_id] = json.loads(user_theme.read_text())
    if path is None:
        path = config_dir() / "exports" / f"bifrost-{now_iso().replace(':', '')}.bifrost.json"
    write_json_atomic(path, bundle)
    return path


def read_bundle(path: Path):
    data = json.loads(path.read_text())
    if data.get("format") != BUNDLE_FORMAT:
        raise SystemExit(f"{path}: not a Bifrost bundle")
    if data.get("version", 1) > 1:
        raise SystemExit(f"{path}: bundle version {data['version']} is newer than this bifrostctl")
    return data


