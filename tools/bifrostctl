#!/usr/bin/env python3
"""bifrostctl — command-line access to Bifrost's configuration and health.

    bifrostctl path                         where config lives
    bifrostctl list [SECTION]               settings with value / default / apply mode
    bifrostctl get KEY
    bifrostctl set KEY VALUE                VALUE is JSON; bare words are strings
    bifrostctl reset KEY | --section S | --all
    bifrostctl show                         resolved values as JSON
    bifrostctl validate                     schema + config.json problems
    bifrostctl doctor                       dependency / environment health check
    bifrostctl preset list | set NAME       built-in / user presets (partial base layers)
    bifrostctl profile list | save NAME | load NAME | delete NAME
    bifrostctl export [FILE]                write a .bifrost.json bundle (default: exports dir)
    bifrostctl import FILE [--apply]        show / apply a bundle (backs up first)
    bifrostctl hypr generate [--write]     preview / write ~/.config/bifrost/hypr/bifrost.lua
    bifrostctl hypr verify                  check the generated file with Hyprland --verify-config
    bifrostctl hypr apply                   write bifrost.lua and run it in the live Hyprland
    bifrostctl hypr binds [--json]          the effective keybindings
    bifrostctl hypr status [--json]         generated file current? hooked into hyprland.lua?
    bifrostctl icons list|effective|index [THEME] [--json]   icon themes, the one Bifrost uses, its lookup index
    bifrostctl appearance status|apply [--variant V] [--json] push light/dark + icons to GTK, Qt, the portal
    bifrostctl env                          environment for Bifrost's Quickshell processes
    bifrostctl doctor --production          read-only checks before switching from DMS to Bifrost
    bifrostctl import-dms [--apply] [--appearance] [--themes]
                                            translate DMS settings (read-only) into Bifrost

Add --json to list/import commands for machine-readable output (used by Settings).

Mirrors shell/Core/ConfigLogic.js and Config.qml: same schema, same sparse
config.json. A running shell picks up changes through its file watcher.
Standard library only.
"""

from __future__ import annotations

import argparse
import copy
import math
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
FORMAT_VERSION = 8
NULLABLE_TYPES = {"bool", "int", "real", "color", "string", "font", "icon", "path"}
APPLY_MODES = {"live", "reload", "restart"}
SCOPES = {"shell", "hyprland", "system"}


# ── paths ─────────────────────────────────────────────────────────────────
def config_dir() -> Path:
    if os.environ.get("BIFROST_CONFIG_DIR"):
        return Path(os.environ["BIFROST_CONFIG_DIR"])
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return Path(base) / "bifrost"


def config_file() -> Path:
    return config_dir() / "config.json"


# ── dotted-key helpers (same semantics as ConfigLogic.js) ────────────────
def deep_get(obj, key):
    cur = obj
    for part in key.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return None, False
        cur = cur[part]
    return cur, True


def deep_set(obj, key, value):
    parts = key.split(".")
    cur = obj
    for part in parts[:-1]:
        if not isinstance(cur.get(part), dict):
            cur[part] = {}
        cur = cur[part]
    cur[parts[-1]] = value


def deep_delete(obj, key) -> bool:
    parts = key.split(".")
    trail, cur = [], obj
    for part in parts[:-1]:
        if not isinstance(cur.get(part), dict):
            return False
        trail.append((cur, part))
        cur = cur[part]
    if parts[-1] not in cur:
        return False
    del cur[parts[-1]]
    for parent, name in reversed(trail):
        if parent[name]:
            break
        del parent[name]
    return True


def merge(bottom, top, leaf_keys, prefix=""):
    out = copy.deepcopy(bottom) if isinstance(bottom, dict) else {}
    if not isinstance(top, dict):
        return out
    for name, tv in top.items():
        path = f"{prefix}.{name}" if prefix else name
        if isinstance(tv, dict) and isinstance(out.get(name), dict) and path not in leaf_keys:
            out[name] = merge(out[name], tv, leaf_keys, path)
        else:
            out[name] = copy.deepcopy(tv)
    return out


def norm(v):
    """JSON-normalises like JS: integral floats become ints (1.0 -> 1)."""
    if isinstance(v, float) and v.is_integer():
        return int(v)
    if isinstance(v, list):
        return [norm(x) for x in v]
    if isinstance(v, dict):
        return {k: norm(x) for k, x in v.items()}
    return v


def same(a, b) -> bool:
    return json.dumps(norm(a), sort_keys=True) == json.dumps(norm(b), sort_keys=True)


def coerce(d, raw):
    """Returns (ok, value, error) exactly like ConfigLogic.coerce."""
    key, typ = d["key"], d["type"]

    def fail(msg):
        return False, None, f"{key}: {msg}"

    v = raw
    if v is None:
        return (True, None, "") if d.get("nullable") else fail("null not allowed")
    if typ == "bool":
        if v in ("true", "false"):
            v = v == "true"
        return (True, v, "") if isinstance(v, bool) else fail("expected bool")
    if typ in ("int", "real"):
        if isinstance(v, str) and v.strip():
            try:
                v = float(v)
            except ValueError:
                return fail("expected number")
        if isinstance(v, bool) or not isinstance(v, (int, float)) or v != v or v in (float("inf"), float("-inf")):
            return fail("expected number")
        if typ == "int":
            v = int(round(v))
        if "min" in d and v < d["min"]:
            v = d["min"]
        if "max" in d and v > d["max"]:
            v = d["max"]
        return True, norm(v), ""
    if typ == "enum":
        return (True, v, "") if v in d.get("options", []) else fail(f"expected one of {d.get('options')}")
    if typ == "color":
        if isinstance(v, str) and (v == "" or re.fullmatch(r"#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})", v)):
            return True, v, ""
        return fail('expected #RRGGBB, #AARRGGBB or ""')
    if typ in ("string", "font", "icon", "path"):
        if not isinstance(v, str):
            return fail("expected string")
        if d.get("pattern") and not re.fullmatch(d["pattern"], v):
            return fail("invalid format")
        return True, v, ""
    if typ == "list":
        return (True, copy.deepcopy(v), "") if isinstance(v, list) else fail("expected list")
    if typ in ("object", "widgetLayout"):
        if not isinstance(v, dict):
            return fail("expected object")
        if d.get("deviceFields"):
            result = {}
            defs = {f["key"]: f for f in d["deviceFields"]}
            for name, entry in v.items():
                if not name or len(name) > 256 or any(ord(c) < 32 for c in name) or name in ("__proto__", "constructor", "prototype"):
                    return fail("invalid device name")
                if not isinstance(entry, dict) or entry.get("kind") not in ("keyboard", "mouse", "trackpad") or set(entry) - {"kind", "values", "original"}:
                    return fail("invalid device record")
                result[name] = {"kind": entry["kind"]}
                for group in ("values", "original"):
                    vals = entry.get(group, {})
                    if not isinstance(vals, dict): return fail("invalid device values")
                    result[name][group] = {}
                    for prop, value in vals.items():
                        fd = defs.get(prop)
                        if not fd or entry["kind"] not in fd["kinds"]: return fail("unsupported device field")
                        ok, val, err = (True, "", "") if group == "original" and value == "" and fd["type"] in ("string", "enum") else coerce(fd, value)
                        if not ok: return fail(err)
                        result[name][group][prop] = val
            return True, result, ""
        if d.get("valueOptions"):
            if any(not re.fullmatch(d["mapKeyPattern"], k) or value not in d["valueOptions"] for k, value in v.items()):
                return fail("invalid map entry")
        return True, copy.deepcopy(v), ""
    return fail(f"unknown schema type '{typ}'")


def unknown_keys(tree, entries, prefix=""):
    out = []
    if not isinstance(tree, dict):
        return out
    for name, v in tree.items():
        path = f"{prefix}.{name}" if prefix else name
        if path in entries:
            continue
        if isinstance(v, dict):
            out += unknown_keys(v, entries, path)
        else:
            out.append(path)
    return out


# ── schema ────────────────────────────────────────────────────────────────
def expand_template(t):
    """Same as Schema.qml expandTemplate: one setting per instance and
    property. The first instance is the global one (its own defaults); the
    others default to null = inherit the global value (inheritKey)."""
    if not t:
        return []
    out = []
    first = t["instances"][0]["id"]
    for inst in t["instances"]:
        for prop in t["settings"]:
            d = {k: v for k, v in prop.items() if k not in ("key", "globalDefault")}
            d["key"] = f"{t['prefix']}.{inst['id']}.{prop['key']}"
            d["instance"] = inst["id"]
            d["prop"] = prop["key"]
            d["group"] = inst["id"]
            if inst["id"] == first:
                d["default"] = prop.get("globalDefault")
                d["nullable"] = prop.get("globalDefault") is None or prop.get("nullable", False)
            else:
                d["default"] = None
                d["nullable"] = True
                d["inheritKey"] = f"{t['prefix']}.{first}.{prop['key']}"
            out.append(d)
    return out


class Schema:
    def __init__(self, schema_dir: Path = REPO / "schema"):
        self.errors: list[str] = []
        self.sections: list[dict] = []
        self.entries: dict[str, dict] = {}
        self.keys: list[str] = []
        self.leaf_keys: set[str] = set()
        self.defaults: dict = {}
        index = json.loads((schema_dir / "index.json").read_text())
        for ref in index.get("sections", []):
            try:
                sec = json.loads((schema_dir / ref["file"]).read_text())
            except (OSError, json.JSONDecodeError) as e:
                self.errors.append(f"{ref['file']}: {e}")
                continue
            settings = []
            for raw in sec.get("settings", []) + expand_template(sec.get("template")):
                d = {"scope": "shell", "apply": "live", "advanced": False, "nullable": False, **raw}
                d["section"] = sec["section"]
                if "requires" not in d and "requires" in sec:
                    d["requires"] = sec["requires"]
                problem = self._validate(d)
                if problem:
                    self.errors.append(problem)
                    continue
                self.entries[d["key"]] = d
                self.keys.append(d["key"])
                settings.append(d)
                if d["type"] in ("object", "widgetLayout"):
                    self.leaf_keys.add(d["key"])
                deep_set(self.defaults, d["key"], norm(d["default"]))
            self.sections.append({**{k: v for k, v in sec.items() if k != "settings"}, "category": ref.get("category"), "settings": settings})

    def _validate(self, d):
        key = d.get("key")
        if not key:
            return f"setting without key in section {d['section']}"
        if key in self.entries:
            return f"{key}: duplicate key"
        for other in self.entries:
            if other.startswith(key + ".") or key.startswith(other + "."):
                return f"{key}: overlaps with {other}"
        if d["apply"] not in APPLY_MODES:
            return f"{key}: invalid apply '{d['apply']}'"
        if d["scope"] not in SCOPES:
            return f"{key}: invalid scope '{d['scope']}'"
        if d["nullable"] and d["type"] not in NULLABLE_TYPES:
            return f"{key}: type {d['type']} cannot be nullable"
        if d.get("default") is None:
            return "" if d["nullable"] else f"{key}: null default on non-nullable setting"
        ok, value, err = coerce(d, d["default"])
        if not ok:
            return f"default invalid: {err}"
        if not same(value, d["default"]):
            return f"{key}: default {json.dumps(d['default'])} is outside its bounds"
        return ""

    def section_keys(self, section_id):
        return [d["key"] for s in self.sections if s["section"] == section_id for d in s["settings"]]



# ── light/dark, icon themes and system appearance ─────────────────────────
def runtime_dir() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / ("bifrost-test" if os.environ.get("BIFROST_CONFIG_DIR") else "bifrost")


def gsettings_get(schema, key):
    if not shutil.which("gsettings"):
        return None
    code, out = run(["gsettings", "get", schema, key])
    return out.strip().strip("'") if code == 0 else None


def effective_variant(cfg) -> str:
    """dark|light as the shell currently shows it (ThemeMode in QML)."""
    mode = deep_get(cfg.values, "appearance.mode")[0]
    if mode in ("light", "dark"):
        return mode
    try:
        v = json.loads((runtime_dir() / "appearance.json").read_text()).get("variant")
        if v in ("light", "dark"):
            return v
    except (OSError, ValueError):
        pass
    scheme = gsettings_get("org.gnome.desktop.interface", "color-scheme")
    return "light" if scheme in ("prefer-light", "default") else "dark"


def icon_base_dirs():
    home = Path(os.path.expanduser("~"))
    data_home = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share")
    dirs = [data_home / "icons", home / ".icons"]
    for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"):
        if d:
            dirs.append(Path(d) / "icons")
    out = []
    for d in dirs:
        if d not in out:
            out.append(d)
    return out


def read_index_theme(theme):
    """Parsed index.theme of `theme`: {name, inherits, dirs: {dir: {size, type, min, max, scale}}, roots}."""
    roots = [b / theme for b in icon_base_dirs() if (b / theme).is_dir()]
    idx = next((r / "index.theme" for r in roots if (r / "index.theme").exists()), None)
    if not idx:
        return None
    sections, cur = {}, None
    for line in idx.read_text(errors="replace").splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            cur = sections.setdefault(line[1:-1], {})
        elif "=" in line and cur is not None and not line.startswith("#"):
            k, _, v = line.partition("=")
            cur[k.strip()] = v.strip()
    head = sections.get("Icon Theme", {})
    dirs = {}
    for dname in [x for x in (head.get("Directories", "") + "," + head.get("ScaledDirectories", "")).split(",") if x]:
        sec = sections.get(dname, {})
        try:
            size = int(sec.get("Size", "0"))
        except ValueError:
            size = 0
        dirs[dname] = {"size": size, "type": sec.get("Type", "Threshold"), "scale": int(sec.get("Scale", "1") or 1)}
    return {"name": head.get("Name", theme), "inherits": [x for x in head.get("Inherits", "").split(",") if x],
            "hidden": head.get("Hidden", "false").lower() == "true", "dirs": dirs, "roots": roots,
            "dark": "dark" in theme.lower() or "dark" in head.get("Name", "").lower()}


def installed_icon_themes():
    seen = {}
    for b in icon_base_dirs():
        if not b.is_dir():
            continue
        for t in sorted(b.iterdir()):
            if t.name in seen or t.name in ("default", "hicolor", "locolor") or not (t / "index.theme").exists():
                continue
            info = read_index_theme(t.name)
            if info and not info["hidden"] and info["dirs"]:
                seen[t.name] = {"id": t.name, "name": info["name"], "dark": info["dark"]}
    return sorted(seen.values(), key=lambda x: x["id"].lower())


def icon_theme_exists(theme):
    return bool(theme) and read_index_theme(theme) is not None


def system_icon_theme():
    """The icon theme the desktop uses when Bifrost doesn't choose one."""
    t = gsettings_get("org.gnome.desktop.interface", "icon-theme")
    if icon_theme_exists(t):
        return t
    for f in (Path(os.path.expanduser("~/.config/gtk-3.0/settings.ini")),):
        if f.exists():
            m = re.search(r"^gtk-icon-theme-name\s*=\s*(.+)$", f.read_text(), re.M)
            if m and icon_theme_exists(m.group(1).strip()):
                return m.group(1).strip()
    return "hicolor"


def effective_icon_theme(cfg, variant=None):
    """Resolve the shared FullBlue default, explicit system/custom choice and fallback."""
    choice = deep_get(cfg.values, "appearance.icons.theme")[0]
    variant = variant or effective_variant(cfg)
    if choice == "system":
        return system_icon_theme(), "system"
    if choice:
        return (choice, "custom") if icon_theme_exists(choice) else (system_icon_theme(), "missing")
    default = "Gruvbox-Plus-Dark-IceBlue-FullBlue"
    return (default, "default") if icon_theme_exists(default) else (system_icon_theme(), "default-missing")


def icon_theme_chain(theme):
    chain, todo = [], [theme]
    while todo:
        t = todo.pop(0)
        if t in chain:
            continue
        info = read_index_theme(t)
        if not info:
            continue
        chain.append(t)
        todo = info["inherits"] + todo
    if "hicolor" not in chain and read_index_theme("hicolor"):
        chain.append("hicolor")
    return chain


def build_icon_index(theme, target=64):
    """{name: path} for every icon in the theme chain: the first theme in the
    chain that has a name wins; within it scalable, then the size nearest
    `target` (larger preferred)."""
    icons = {}
    for t in icon_theme_chain(theme):
        info = read_index_theme(t)
        best = {}
        for dname, d in info["dirs"].items():
            if d["scale"] != 1:
                continue
            score = 0 if d["type"] == "Scalable" else abs(d["size"] - target) + (0.5 if d["size"] < target else 0)
            for root in info["roots"]:
                folder = root / dname
                if not folder.is_dir():
                    continue
                for f in folder.iterdir():
                    stem, ext = os.path.splitext(f.name)
                    if ext not in (".svg", ".png", ".xpm") or stem in icons:
                        continue
                    if stem not in best or score < best[stem][0]:
                        best[stem] = (score, str(f))
        for stem, (_, path) in best.items():
            icons.setdefault(stem, path)
    pix = Path("/usr/share/pixmaps")
    if pix.is_dir():
        for f in pix.iterdir():
            stem, ext = os.path.splitext(f.name)
            if ext in (".svg", ".png", ".xpm"):
                icons.setdefault(stem, str(f))
    return icons


def icon_index_file(theme) -> Path:
    """Cached index for `theme`, rebuilt when a theme dir in the chain changes."""
    cache = Path(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")) / "bifrost" / "icons"
    cache.mkdir(parents=True, exist_ok=True)
    f = cache / f"{theme}.json"
    stamp = 0.0
    for t in icon_theme_chain(theme):
        for r in read_index_theme(t)["roots"]:
            stamp = max(stamp, r.stat().st_mtime, (r / "index.theme").stat().st_mtime if (r / "index.theme").exists() else 0)
    if f.exists():
        try:
            if json.loads(f.read_text()).get("stamp") == stamp:
                return f
        except ValueError:
            pass
    write_json_atomic(f, {"theme": theme, "chain": icon_theme_chain(theme), "stamp": stamp, "icons": build_icon_index(theme)})
    return f


def gtk_theme_variant(name, variant):
    """MacTahoe-Dark ↔ MacTahoe-Light, Adwaita ↔ Adwaita-dark: the installed
    counterpart of a GTK theme for `variant`, or None."""
    if not name:
        return None
    bases = [Path(os.path.expanduser("~/.themes")), Path(os.path.expanduser("~/.local/share/themes")), Path("/usr/share/themes")]
    exists = lambda n: any((b / n).is_dir() for b in bases)
    stem = re.sub(r"[-_](dark|light)$", "", name, flags=re.I)
    m = re.search(r"[-_](dark|light)$", name, re.I)
    sep = name[len(stem)] if m else "-"
    cap = (m.group(1)[0].isupper()) if m else True
    word = lambda w: w.capitalize() if cap else w
    cands = [stem + sep + word("dark"), stem + "-dark"] if variant == "dark" else [stem + sep + word("light"), stem]
    for c in cands:
        if exists(c):
            return c
    return None


def backup_once(path: Path):
    """First time Bifrost edits a file it doesn't own, keep the original."""
    if not path.exists():
        return
    dest = config_dir() / "backups" / "system" / (path.parent.name + "__" + path.name + ".orig")
    if not dest.exists():
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, dest)


def ini_set(path: Path, section, key, value):
    """Sets one key in an INI file, keeping everything else as it is."""
    if ini_get(path, section, key) == value:
        return
    backup_once(path)
    lines = path.read_text().splitlines() if path.exists() else []
    out, in_sec, done = [], False, False
    for line in lines:
        st = line.strip()
        if st.startswith("[") and st.endswith("]"):
            if in_sec and not done:
                out.append(f"{key}={value}")
                done = True
            in_sec = st[1:-1] == section
        elif in_sec and re.match(rf"^{re.escape(key)}\s*=", st):
            if not done:
                out.append(f"{key}={value}")
                done = True
            continue
        out.append(line)
    if not done:
        if not in_sec:
            out.append(f"[{section}]")
        out.append(f"{key}={value}")
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".bifrost-tmp")
    tmp.write_text("\n".join(out) + "\n")
    os.replace(tmp, path)


def ini_get(path: Path, section, key):
    if not path.exists():
        return None
    in_sec = False
    for line in path.read_text().splitlines():
        st = line.strip()
        if st.startswith("[") and st.endswith("]"):
            in_sec = st[1:-1] == section
        elif in_sec and "=" in st and st.split("=", 1)[0].strip() == key:
            return st.split("=", 1)[1].strip()
    return None


def appearance_apply(cfg, variant, dry=False):
    """Pushes light/dark and the icon theme to the rest of the desktop.
    Returns [{target, status, detail}] with status ok|skipped|unsupported|error."""
    rows = []
    add = lambda t, st, d: rows.append({"target": t, "status": st, "detail": d})
    icons, source = effective_icon_theme(cfg, variant)
    manage_icons = source in ("default", "custom")
    gs = shutil.which("gsettings")
    iface = "org.gnome.desktop.interface"

    def gset(key, value):
        if dry:
            return True
        return run(["gsettings", "set", iface, key, value])[0] == 0

    if gs and gsettings_get(iface, "color-scheme") is not None:
        scheme = "prefer-dark" if variant == "dark" else "prefer-light"
        add("portal", "ok" if gset("color-scheme", scheme) else "error", f"color-scheme = {scheme} (browsers, GTK4/libadwaita, Qt via the portal)")
        cur = gsettings_get(iface, "gtk-theme")
        other = gtk_theme_variant(cur, variant)
        if other and other != cur:
            add("gtk", "ok" if gset("gtk-theme", other) else "error", f"gtk-theme {cur} → {other}")
        elif other:
            add("gtk", "ok", f"gtk-theme {cur}")
        else:
            add("gtk", "unsupported", f"no {variant} variant of the GTK theme {cur} is installed")
        if manage_icons:
            add("icons", "ok" if gset("icon-theme", icons) else "error", f"icon-theme = {icons}")
    else:
        add("portal", "unsupported", "gsettings / org.gnome.desktop.interface not available")
    for gtk in ("gtk-3.0", "gtk-4.0"):
        f = Path(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")) / gtk / "settings.ini"
        if f.exists():
            if not dry:
                ini_set(f, "Settings", "gtk-application-prefer-dark-theme", "1" if variant == "dark" else "0")
                if manage_icons:
                    ini_set(f, "Settings", "gtk-icon-theme-name", icons)
            add(gtk, "ok", f"{f.name}: prefer-dark = {variant == 'dark'}")
    platform = os.environ.get("QT_QPA_PLATFORMTHEME", "")
    for qt in ("qt6ct", "qt5ct"):
        f = Path(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")) / qt / f"{qt}.conf"
        if not f.exists():
            continue
        details = []
        if manage_icons and not dry:
            ini_set(f, "Appearance", "icon_theme", icons)
            details.append(f"icon_theme = {icons}")
        style = ini_get(f, "Appearance", "style") or ""
        m = re.match(r"^(kvantum)(-dark)?$", style, re.I)
        if m:
            want = "kvantum-dark" if variant == "dark" else "kvantum"
            if want != style and not dry:
                ini_set(f, "Appearance", "style", want)
            details.append(f"style = {want}")
        if (ini_get(f, "Appearance", "custom_palette") or "").lower() == "true":
            details.append("custom colour palette left as it is")
        add(qt, "ok", ", ".join(details) or "nothing to change")
    if platform and platform not in ("qt6ct", "qt5ct", "xdgdesktopportal", "gtk3", "gnome", "kde"):
        add("qt", "unsupported", f"QT_QPA_PLATFORMTHEME={platform} is not managed")
    if not dry:
        runtime_dir().mkdir(parents=True, exist_ok=True)
    return rows

# ── config document ───────────────────────────────────────────────────────
def migrate(doc):
    """Same steps as shell/Core/Migrations.js."""
    v = doc.get("version", 1)
    if v == 1:
        a = doc.get("values", {}).get("appearance")
        if isinstance(a, dict) and "variant" in a:
            a.setdefault("mode", a["variant"])
            del a["variant"]
        doc.pop("appearance", None)
        v = 2
    if v == 2:
        vals = doc.setdefault("values", {})
        a = vals.get("appearance", {})
        m = vals.get("materials", {})

        def put(surface, prop, value):
            if value is None:
                return
            m.setdefault(surface, {}).setdefault(prop, value)
        tr = a.get("transparency", {})
        put("bar", "transparency", tr.get("bar"))
        put("dock", "transparency", tr.get("dock"))
        for s_ in ("menus", "launcher", "controlCenter", "notifications", "settings", "osd"):
            put(s_, "transparency", tr.get("windows"))
        g = a.get("glass", {})
        put("all", "grain", g.get("grain"))
        if g.get("blur") is False:
            put("all", "blur", False)
        b = a.get("borders", {})
        if b.get("enabled") is False:
            put("all", "border", False)
        if isinstance(b.get("opacityScale"), (int, float)):
            put("all", "borderOpacity", round(16 * b["opacityScale"]))
        if a.get("shadows", {}).get("enabled") is False:
            put("all", "shadow", 0)
        if isinstance(vals.get("bar", {}).get("radius"), (int, float)):
            put("bar", "radius", vals["bar"]["radius"])
        hb = vals.get("hyprland", {}).get("blur", {})
        if isinstance(hb.get("size"), (int, float)):
            m["blurStrength"] = max(1, min(100, round((hb["size"] - 1) / 0.39)))
        for k in ("transparency", "glass", "borders", "shadows"):
            a.pop(k, None)
        vals.get("bar", {}).pop("radius", None)
        vals.get("hyprland", {}).pop("blur", None)
        if m:
            vals["materials"] = m
        v = 3
    if v == 3:
        bar = doc.get("values", {}).get("bar")
        if isinstance(bar, dict):
            if bar.get("style") == "islands":
                bar["style"] = "floating"
                bar.setdefault("background", "none")
                bar.setdefault("widgetStyle", "grouped")
            ss = bar.get("systemStatus")
            if isinstance(ss, dict) and "appearance" in ss:
                if ss["appearance"] == "boxed":
                    bar.setdefault("widgetStyle", "boxed")
                del ss["appearance"]
        v = 4
    if v == 4:
        m = doc.get("values", {}).get("materials")
        if isinstance(m, dict):
            strength = m.get("blurStrength") if isinstance(m.get("blurStrength"), (int, float)) and not isinstance(m.get("blurStrength"), bool) else None
            for s_ in m.values():
                if not isinstance(s_, dict) or "blur" not in s_:
                    continue
                if s_["blur"] is False:
                    s_["blur"] = 0
                elif s_["blur"] is True:
                    s_["blur"] = strength if strength is not None else 20
            if strength is not None:
                m.setdefault("all", {}).setdefault("blur", strength)
            m.pop("blurStrength", None)
        v = 5
    if v == 5:
        migrate_5(doc.setdefault("values", {}))
        v = 6
    if v == 6:
        migrate_6(doc.setdefault("values", {}))
        v = 7
    if v == 7:
        bar = doc.setdefault("values", {}).get("bar")
        if isinstance(bar, dict) and bar.get("background") == "subtle":
            bar["background"] = "panel"
        v = 8
    doc["version"] = v
    return doc



def migrate_5(vals):
    """5 → 6 (Migrations.js step 5): one glass for every surface instead of
    per-surface overrides with link/unlink; the prism switch, the spacing
    scale, app window transparency and the Settings layout page are gone."""
    vals.pop("settingsUI", None)
    m = vals.get("materials")
    if isinstance(m, dict):
        all_ = m.get("all") if isinstance(m.get("all"), dict) else {}
        out = {}
        for k in ("transparency", "blur", "tint", "border"):
            if all_.get(k) is not None:
                out[k] = all_[k]
        if isinstance(out.get("blur"), bool):
            out["blur"] = 20 if out["blur"] else 0
        vals["materials"] = out
    a = vals.get("appearance")
    if isinstance(a, dict):
        prism = a.get("prism")
        if isinstance(prism, dict) and "enabled" in prism:
            if prism.pop("enabled") is False:
                prism["intensity"] = 0
            if not prism:
                del a["prism"]
        scale = a.pop("spacingScale", None)
        if isinstance(scale, (int, float)) and not isinstance(scale, bool) and "density" not in a:
            if scale >= 1.2:
                a["density"] = "spacious"
            elif scale <= 0.85:
                a["density"] = "compact"
    w = vals.get("hyprland", {}).get("windows") if isinstance(vals.get("hyprland"), dict) else None
    if isinstance(w, dict):
        w.pop("activeTransparency", None)
        w.pop("inactiveTransparency", None)
        if not w:
            del vals["hyprland"]["windows"]


def migrate_6(vals):
    """6 → 7 (Migrations.js step 6): accent and glass tint per light/dark mode."""
    for section, key in (("appearance", "accent"), ("materials", "tint")):
        s = vals.get(section)
        if isinstance(s, dict) and key in s:
            if isinstance(s[key], str):
                s[key] = {"light": s[key], "dark": s[key]}
            elif not isinstance(s[key], dict):
                del s[key]


class Config:
    def __init__(self, schema: Schema):
        self.schema = schema
        self.path = config_file()
        self.issues: list[str] = []
        self.doc = {"version": FORMAT_VERSION, "values": {}}
        if self.path.exists():
            text = self.path.read_text()
            if text.strip():
                self.doc = json.loads(text)  # let JSONDecodeError surface to the caller
            if not isinstance(self.doc.get("values"), dict):
                self.doc["values"] = {}
        version = self.doc.get("version", 1)
        if version < FORMAT_VERSION:
            self.doc = migrate(self.doc)
        if version > FORMAT_VERSION:
            raise SystemExit(f"config.json is version {version}, newer than this bifrostctl ({FORMAT_VERSION})")
        self.preset = os.environ.get("BIFROST_PRESET") or self.doc.get("preset") or "default"
        self.preset_values = self._validated(self._load_preset(self.preset), f"preset {self.preset}")
        self.overrides = self._validated(self.doc["values"], "config.json")
        self.base = merge(schema.defaults, self.preset_values, schema.leaf_keys)
        self.values = merge(self.base, self.overrides, schema.leaf_keys)

    def _load_preset(self, pid):
        if pid == "default":
            return {}
        for d in (config_dir() / "presets", REPO / "presets"):
            f = d / f"{pid}.json"
            if f.exists():
                return json.loads(f.read_text()).get("values", {})
        self.issues.append(f"preset '{pid}' not found")
        return {}

    def _validated(self, tree, kind):
        out = {}
        for key in self.schema.keys:
            raw, found = deep_get(tree, key)
            if not found:
                continue
            ok, value, err = coerce(self.schema.entries[key], raw)
            if ok:
                deep_set(out, key, value)
            else:
                self.issues.append(f"{kind}: {err}")
        for key in unknown_keys(tree, self.schema.entries):
            self.issues.append(f"{kind}: unknown setting '{key}' (kept in file)")
        return out

    def set(self, key, value):
        d = self.schema.entries.get(key)
        if not d:
            raise SystemExit(f"unknown setting '{key}'")
        ok, v, err = coerce(d, value)
        if not ok:
            raise SystemExit(err)
        base, _ = deep_get(self.base, key)
        if same(v, base):
            deep_delete(self.doc["values"], key)
        else:
            deep_set(self.doc["values"], key, v)
        return v

    def save(self):
        out = {"version": FORMAT_VERSION}
        if self.doc.get("preset"):
            out["preset"] = self.doc["preset"]
        out["values"] = norm(self.doc.get("values", {}))
        for k, v in self.doc.items():
            out.setdefault(k, v)
        self.path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=self.path.parent, prefix=".config.", suffix=".tmp")
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(out, indent=2, ensure_ascii=False) + "\n")
        os.replace(tmp, self.path)


def parse_value(text):
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return text


# ── doctor ────────────────────────────────────────────────────────────────
from dependencies import (version_tuple, run, qml_import_paths, check_dependency,
                          distro_info, install_hint)


def doctor(_args):
    colours = {"ok": "\033[32m✓\033[0m", "warn": "\033[33m!\033[0m", "fail": "\033[31m✗\033[0m"} if sys.stdout.isatty() else {"ok": "ok  ", "warn": "WARN", "fail": "FAIL"}
    worst = "ok"
    rank = {"ok": 0, "warn": 1, "fail": 2}

    def report(status, name, detail, hint=""):
        nonlocal worst
        worst = max(worst, status, key=rank.get)
        print(f" {colours[status]} {name:<22} {detail}" + (f"\n     → {hint}" if hint and status != "ok" else ""))

    manifest = json.loads((REPO / "dependencies.json").read_text())
    print("Dependencies (dependencies.json)")
    for dep in manifest["dependencies"]:
        status, detail = check_dependency(dep)
        hint = install_hint(dep, distro_info()[0])
        report(status, dep["id"], f"[{dep.get('level')}] {detail}", hint)

    print("\nSession")
    comp = "hyprland" if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") else "niri" if os.environ.get("NIRI_SOCKET") else "none"
    report("ok" if comp == "hyprland" else "warn", "compositor", comp, "Hyprland is the supported compositor for now; Niri is planned")
    if comp == "hyprland":
        code, out = run(["hyprctl", "eval", "return 1"])
        report("ok" if code == 0 else "warn", "hyprland lua/eval", "available" if code == 0 else out.strip()[:100],
               "Surface blur needs Hyprland >= 0.55 with a Lua config")
    shell_running = run(["pgrep", "-f", f"qs .*-p {REPO / 'shell'}/?( |$)"])[0] == 0
    report("ok", "bifrost shell", "running" if shell_running else "not running")

    print("\nConfiguration")
    schema = Schema()
    report("fail" if schema.errors else "ok", "schema", f"{len(schema.keys)} settings" if not schema.errors else "; ".join(schema.errors))
    try:
        cfg = Config(schema)
        detail = f"{config_file()} ({len(cfg.issues)} issues)" if config_file().exists() else f"{config_file()} (not created yet — all defaults)"
        report("warn" if cfg.issues else "ok", "config.json", detail, "; ".join(cfg.issues))
    except json.JSONDecodeError as e:
        report("fail", "config.json", f"invalid JSON: {e}", "fix the file; Bifrost refuses to overwrite it")

    print()
    return {"ok": 0, "warn": 0, "fail": 1}[worst]




