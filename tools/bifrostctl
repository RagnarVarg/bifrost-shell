                raise SystemExit(f"icon theme '{theme}' not installed")
            f = icon_index_file(theme)
            print(json.dumps({"theme": theme, "file": str(f)}) if args.json else f)
        return 0
    if args.cmd == "appearance":
        cfg = Config(Schema())
        variant = args.variant or effective_variant(cfg)
        rows = appearance_apply(cfg, variant, dry=args.action == "status")
        print(json.dumps({"variant": variant, "icons": effective_icon_theme(cfg, variant)[0], "targets": rows}) if args.json
              else "\n".join(f"{r['status']:<12} {r['target']:<8} {r['detail']}" for r in rows))
        return 0 if all(r["status"] != "error" for r in rows) else 1
    if args.cmd == "env":
        # Environment for Bifrost's Quickshell processes (scripts/env.sh).
        theme, _ = effective_icon_theme(Config(Schema()))
        if theme and theme != "hicolor":
            print(f"export QS_ICON_THEME={shlex.quote(theme)}")
        return 0
    if args.cmd == "themes":
        sys.path.insert(0, str(REPO / "tools"))
        import theme_catalog
        try:
            result = theme_catalog.run(args, config_dir(), deep_get(Config(Schema()).values, "appearance.theme")[0], write_json_atomic)
        except (OSError, ValueError) as error:
            print(json.dumps({"error": str(error)}))
            return 1
        print(json.dumps(result, ensure_ascii=False))
        return 0
    if args.cmd == "path":
        print(config_file())
        return 0

    schema = Schema()
    if args.cmd == "validate":
        problems = list(schema.errors)
        try:
            problems += Config(schema).issues
        except json.JSONDecodeError as e:
            problems.append(f"config.json: invalid JSON: {e}")
        for p in problems:
            print(p)
        print("ok" if not problems else f"{len(problems)} problem(s)")
        return 1 if problems else 0


    if args.cmd == "preset":
        if args.action == "list":
            items = list_presets()
            print(json.dumps(items, ensure_ascii=False) if args.json else "\n".join(f"{p['id']:<16} {p['name']} — {p['description']}" for p in items))
            return 0
        if not args.name or args.name not in [p["id"] for p in list_presets()]:
            raise SystemExit("unknown preset")
        cfg = Config(schema)
        apply_values(cfg, cfg.doc.get("values", {}), preset=args.name, replace=True)
        print(f"preset = {args.name}")
        return 0

    if args.cmd == "profile":
        if args.action == "list":
            items = list_profiles()
            print(json.dumps(items, ensure_ascii=False) if args.json else "\n".join(f"{p['name']:<24} {p['count']:>3} inställningar  {p['created']}" for p in items))
            return 0
        if not args.name:
            raise SystemExit("profile name required")
        path = profile_path(args.name)
        if args.action == "save":
            cfg = Config(schema)
            write_json_atomic(path, {"name": args.name, "created": now_iso(), "preset": cfg.doc.get("preset", "default"), "values": cfg.doc.get("values", {})})
            print(f"saved profile '{args.name}' → {path}")
        elif args.action == "load":
            if not path.exists():
                raise SystemExit(f"no profile '{args.name}'")
            data = json.loads(path.read_text())
            b = backup_config("before-profile")
            problems = apply_values(Config(schema), data.get("values", {}), preset=data.get("preset", "default"))
            print(f"loaded profile '{args.name}'" + (f" (backup: {b})" if b else ""))
            for pr in problems:
                print("  " + pr)
        elif args.action == "delete":
            path.unlink(missing_ok=True)
            print(f"deleted profile '{args.name}'")
        return 0

    if args.cmd == "export":
        path = export_bundle(Config(schema), Path(args.file) if args.file else None)
        print(path)
        return 0

    if args.cmd == "import":
        bundle = read_bundle(Path(args.file))
        cfg = Config(schema)
        changes = diff_values(schema, cfg.values, bundle.get("values", {}))
        if args.json and not args.apply:
            print(json.dumps({"changes": [{"key": k, "old": o, "new": n} for k, o, n in changes], "themes": list(bundle.get("themes", {}))}, ensure_ascii=False))
            return 0
        for k, o, n in changes:
            print(f"  {k}: {fmt(o)} → {fmt(n)}")
        if not args.apply:
            print(f"{len(changes)} change(s); run with --apply to import")
            return 0
        for tid, tdata in bundle.get("themes", {}).items():
            write_json_atomic(config_dir() / "themes" / f"{tid}.json", tdata)
        b = backup_config("before-import")
        problems = apply_values(cfg, bundle.get("values", {}), preset=bundle.get("preset", "default"))
        print(f"imported {args.file}" + (f" (backup: {b})" if b else ""))
        for pr in problems:
            print("  " + pr)
        return 0

    if args.cmd == "import-dms" and args.detect:
        found = (dms_paths()[0] / "settings.json").exists()
        print(json.dumps({"found": found}) if args.json else ("found" if found else "not found"))
        return 0
    if args.cmd == "import-dms":
        values, notes, themes = dms_translate(args.appearance)
        cfg = Config(schema)
        changes = diff_values(schema, cfg.values, values)
        if args.json:
            print(json.dumps({"changes": [{"key": k, "old": o, "new": n} for k, o, n in changes],
                              "notes": notes, "themes": [t["id"] for t in themes.values()], "applied": bool(args.apply)}, ensure_ascii=False))
        else:
            for k, o, n in changes:
                print(f"  {k}: {fmt(o)} → {fmt(n)}")
            for n_ in notes:
                if n_["key"] is None:
                    print(f"  (skipped) {n_['value']}: {n_['from']}")
            if args.themes:
                print(f"  themes: {', '.join(t['id'] for t in themes.values())}")
        if not args.apply:
            if not args.json:
                print(f"{len(changes)} change(s) from DMS; nothing written. Run with --apply to import.")
            return 0
        if args.themes:
            for t in themes.values():
                write_json_atomic(config_dir() / "themes" / f"{t['id']}.json", t)
        b = backup_config("before-dms-import")
        merged = merge(cfg.doc.get("values", {}), values, schema.leaf_keys)
        problems = apply_values(cfg, merged, preset=None, replace=True)
        if not args.json:
            print("imported from DMS" + (f" (backup: {b})" if b else ""))
            for pr in problems:
                print("  " + pr)
        return 0

    cfg = Config(schema)
    if args.cmd == "show":
        print(json.dumps(cfg.values, indent=2, ensure_ascii=False))
    elif args.cmd == "get":
        if args.key not in schema.entries:
            raise SystemExit(f"unknown setting '{args.key}'")
        print(fmt(deep_get(cfg.values, args.key)[0]))
    elif args.cmd == "list":
        for key in schema.keys:
            d = schema.entries[key]
            if args.section and d["section"] != args.section:
                continue
            value = deep_get(cfg.values, key)[0]
            mark = "*" if deep_get(cfg.overrides, key)[1] else " "
            print(f"{mark} {key:<36} {fmt(value):<24} default={fmt(d.get('default'))}  [{d['apply']}]")
    elif args.cmd == "set":
        v = cfg.set(args.key, parse_value(args.value))
        cfg.save()
        mode = schema.entries[args.key]["apply"]
        print(f"{args.key} = {fmt(v)}" + ("" if mode == "live" else f"  (takes effect after shell {mode})"))
    elif args.cmd == "reset":
        keys = schema.keys if args.all else schema.section_keys(args.section) if args.section else [args.key]
        if not keys or (args.key and args.key not in schema.entries):
            raise SystemExit("nothing to reset (unknown key or section)")
        for k in keys:
            deep_delete(cfg.doc["values"], k)
        cfg.save()
        print(f"reset {len(keys)} setting(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
