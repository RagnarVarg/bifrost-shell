}


def dms_paths():
    home = Path(os.path.expanduser("~"))
    cfg = Path(os.environ.get("BIFROST_DMS_CONFIG", home / ".config/DankMaterialShell"))
    state = Path(os.environ.get("BIFROST_DMS_STATE", home / ".local/state/DankMaterialShell"))
    return cfg, state


def hex_mix(a, b, t):
    ca = [int(a[i:i + 2], 16) for i in (1, 3, 5)]
    cb = [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * t):02X}" for x, y in zip(ca, cb))


def dms_theme_to_bifrost(theme_id, data):
    def variant(p, dark):
        base = p.get("background", "#101010" if dark else "#EEEEEE")
        text = p.get("surfaceText", "#EEEEEE" if dark else "#111111")
        accent = p.get("primary", "#8899AA")
        return {"palette": {
            "void": hex_mix(base, "#000000" if dark else "#FFFFFF", 0.35),
            "base": base,
            "surface": p.get("surface", base),
            "surfaceRaised": p.get("surfaceContainer", p.get("surface", base)),
            "surfaceHover": p.get("surfaceContainerHigh", p.get("surfaceVariant", base)),
            "text": text,
            "textMuted": hex_mix(text, base, 0.35),
            "textFaint": hex_mix(text, base, 0.6),
            "silver": p.get("outline", hex_mix(text, base, 0.2)),
            "silverBright": hex_mix(text, "#FFFFFF", 0.3) if dark else "#FFFFFF",
            "accent": accent,
            "accentDeep": hex_mix(accent, base, 0.35),
            "accentText": p.get("primaryText", base),
            "success": p.get("success", "#7FB89A"),
            "warning": p.get("warning", "#D6A76A"),
            "danger": p.get("error", "#D0707A"),
            "aurora": [accent, p.get("secondary", accent), p.get("info", accent)],
        }}
    out = {"id": f"dms-{theme_id}", "name": f"{data.get('name', theme_id)} (från DMS)", "version": 1,
           "extends": "_base", "description": f"Converted from DMS theme '{theme_id}' by bifrostctl import-dms", "variants": {}}
    for mode in ("dark", "light"):
        if isinstance(data.get(mode), dict):
            out["variants"][mode] = variant(data[mode], mode == "dark")
    return out


def dms_translate(include_appearance=False):
    """Returns (values, notes, themes) translated from DMS files. Reads only."""
    cfg_dir, state_dir = dms_paths()
    values, notes = {}, []
    settings = json.loads((cfg_dir / "settings.json").read_text()) if (cfg_dir / "settings.json").exists() else {}
    session = json.loads((state_dir / "session.json").read_text()) if (state_dir / "session.json").exists() else {}
    if not settings and not session:
        raise SystemExit(f"no DMS files found under {cfg_dir} / {state_dir}")

    def put(key, value, why):
        deep_set(values, key, value)
        notes.append({"key": key, "value": value, "from": why})

    if session.get("wallpaperPath"):
        put("wallpaper.path", session["wallpaperPath"], "session.wallpaperPath")
    if session.get("pinnedApps"):
        put("dock.pinned", session["pinnedApps"], "session.pinnedApps")
    if session.get("hiddenApps"):
        put("launcher.hidden", session["hiddenApps"], "session.hiddenApps")
    if "dockSmartAutoHide" in settings or "dockAutoHide" in settings:
        smart = bool(settings.get("dockSmartAutoHide"))
        put("dock.autohide", smart or bool(settings.get("dockAutoHide")), "settings.dockSmartAutoHide/dockAutoHide")
        put("dock.smartHide", smart, "settings.dockSmartAutoHide")
    if "showDock" in settings:
        put("dock.enabled", bool(settings["showDock"]), "settings.showDock")
    if "dockIconSize" in settings:
        put("dock.iconSize", max(28, min(72, int(settings["dockIconSize"]))), "settings.dockIconSize")
    if "showWeekNumber" in settings:
        put("clock.weekNumber", bool(settings["showWeekNumber"]), "settings.showWeekNumber")
    if settings.get("iconThemeDark"):
        put("appearance.icons.theme", settings["iconThemeDark"], "settings.iconThemeDark")

    bar = (settings.get("barConfigs") or [{}])[0]
    if bar:
        if "position" in bar:
            put("bar.position", "bottom" if bar["position"] == 1 else "top", "barConfigs[0].position")
        if "autoHide" in bar:
            put("bar.autohide.enabled", bool(bar["autoHide"]), "barConfigs[0].autoHide")
        if "autoHideDelay" in bar:
            put("bar.autohide.delayMs", max(0, min(3000, int(bar["autoHideDelay"]))), "barConfigs[0].autoHideDelay")
        if "autoHideStrict" in bar:
            put("bar.autohide.pinWhilePopupOpen", not bar["autoHideStrict"], "barConfigs[0].autoHideStrict (inverted)")
        widgets, skipped = {}, []
        for zone, dms_zone in (("left", "leftWidgets"), ("center", "centerWidgets"), ("right", "rightWidgets")):
            out = []
            for w in bar.get(dms_zone, []):
                if not w.get("enabled", True):
                    continue
                wid = DMS_WIDGETS.get(w.get("id"))
                if not wid:
                    skipped.append(w.get("id"))
                    continue
                if any(x["id"] == wid for z in list(widgets.values()) + [out] for x in z) and wid != "spacer":
                    continue
                out.append({"id": wid})   # DMS spacer sizes are pixels; Bifrost uses spacing steps
            widgets[zone] = out
        if not any(x["id"] == "settings" for z in widgets.values() for x in z):
            widgets.setdefault("right", []).append({"id": "settings"})
            notes.append({"key": "bar.widgets", "value": "settings", "from": "added: Bifrost Settings button"})
        put("bar.widgets", widgets, "barConfigs[0].*Widgets")
        for s_ in skipped:
            notes.append({"key": None, "value": s_, "from": "DMS widget without Bifrost equivalent (skipped)"})
        if include_appearance:
            if "spacing" in bar:
                put("bar.spacing", max(0, min(24, int(bar["spacing"]))), "barConfigs[0].spacing")

    if include_appearance and "cornerRadius" in settings:
        put("appearance.radiusScale", round(max(0.0, min(2.0, settings["cornerRadius"] / 12.0 * 0.65)), 2), "settings.cornerRadius")
    if session.get("weatherLocation"):
        notes.append({"key": None, "value": session["weatherLocation"], "from": "weather location (no weather widget yet)"})

    themes = {}
    for f in sorted((cfg_dir / "themes").glob("*/theme.json")):
        try:
            themes[f.parent.name] = dms_theme_to_bifrost(f.parent.name, json.loads(f.read_text()))
        except (json.JSONDecodeError, OSError, ValueError, IndexError):
            notes.append({"key": None, "value": f.parent.name, "from": "DMS theme could not be converted"})
    return values, notes, themes


# ── Hyprland integration (generated file; never the user's own config) ──────
def hypr_file() -> Path:
    return config_dir() / "hypr" / "bifrost.lua"


def theme_palette(cfg):
    """Resolved palette of the active theme/variant (for border colours)."""
    theme_id = deep_get(cfg.values, "appearance.theme")[0] or "bifrost-graphite"
    variant = effective_variant(cfg)
    for d in (config_dir() / "themes", REPO / "themes"):
        f = d / f"{theme_id}.json"
        if f.exists():
            t = json.loads(f.read_text())
            return t.get("variants", {}).get(variant, {}).get("palette", {})
    return {}


def lua_str(s):
    return json.dumps(s)


def install_bin_lua() -> str:
    """Lua expression for Bifrost's bin/ dir, relative to $HOME when possible
    so the generated file never carries a personal path."""
    home = Path(os.path.expanduser("~"))
    data_home = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share")
    # The session's shell runs from the standard install path, a copy or a
    # --link to a checkout: whenever it exists, its bin/ is what binds must
    # call. A checkout's own bin/ would reach no shell (bifrost-ipc finds the
    # shell next to itself), which silently broke every IPC bind after a
    # `bifrostctl hypr apply` run from a checkout next to a copied install.
    installed = data_home / "bifrost-shell"
    bin_dir = installed / "bin" if (installed / "bin" / "bifrost-ipc").exists() else REPO / "bin"
    try:
        rel = bin_dir.relative_to(home)
        return f'os.getenv("HOME") .. {lua_str("/" + str(rel) + "/")}'
    except ValueError:
        return lua_str(str(bin_dir) + "/")


def keybind_defaults():
    return json.loads((REPO / "hypr" / "keybinds.json").read_text())


def gesture_actions():
    """What a trackpad gesture can do (keybinds.json gestureActions), resolved:
    [{value, label, native} | {value, label, ipc}] in Settings order. Bifrost
    actions reuse a bind's or action's ipc and description, so a gesture and a
    shortcut run the same thing."""
    d = keybind_defaults()
    known = {x["id"]: x for x in d.get("binds", []) + d.get("actions", [])}
    out = []
    for g in d.get("gestureActions", []):
        if "native" in g:
            out.append({"value": g["value"], "label": g["label"], "native": g["native"]})
        elif g.get("action") in known and known[g["action"]].get("ipc"):
            a = known[g["action"]]
            out.append({"value": g["value"], "label": g.get("label", a.get("label", a["description"])), "ipc": a["ipc"]})
    return out


def parse_custom_bind(line: str):
    """'SUPER + X: ipc controlcenter toggle' | '…: run cmd' | '…: dispatch hl.dsp…'."""
    keys, _, action = line.partition(":")
    kind, _, arg = action.strip().partition(" ")
    if not keys.strip() or kind not in ("ipc", "run", "dispatch") or not arg.strip():
        return None
    return {"keys": keys.strip(), kind: arg.strip(), "description": "custom"}


# Key combinations. Canonical form: modifiers in a fixed order, then the key
# ("SUPER + SHIFT + Q"); keys_id() is what two combinations are compared by
# (case-insensitive, digit-row keycodes = the digit).
KEY_MODS = ["SUPER", "CTRL", "ALT", "SHIFT"]
MOD_ALIASES = {"SUPER": "SUPER", "WIN": "SUPER", "LOGO": "SUPER", "MOD4": "SUPER", "META": "SUPER",
               "CTRL": "CTRL", "CONTROL": "CTRL", "ALT": "ALT", "MOD1": "ALT", "SHIFT": "SHIFT"}
MODMASK_BITS = {"SHIFT": 1, "CTRL": 4, "ALT": 8, "SUPER": 64}
DIGIT_CODES = {f"code:{9 + i}": str(i % 10) for i in range(1, 11)}   # code:10 = 1 … code:19 = 0


def canon_keys(keys):
    """'shift + super + q' → 'SUPER + SHIFT + Q'; None when it is not one key with modifiers."""
    if not isinstance(keys, str):
        return None
    parts = [x.strip() for x in keys.split("+") if x.strip()]
    mods, key = set(), None
    for part in parts:
        mod = MOD_ALIASES.get(part.upper())
        if mod:
            mods.add(mod)
        elif key is None and re.fullmatch(r"[A-Za-z0-9_:.\-]+", part):
            key = part.upper() if len(part) == 1 else part
        else:
            return None
    return " + ".join([m for m in KEY_MODS if m in mods] + [key]) if key else None


def keys_id(keys) -> str:
    c = canon_keys(keys) or re.sub(r"\s+", "", str(keys))
    *mods, key = c.split(" + ")
    return " + ".join(mods + [DIGIT_CODES.get(key.lower(), key)]).lower()


def default_keybinds(cfg):
    """Every default bind of the current workspace style, with ids, groups on or off."""
    v = lambda k: deep_get(cfg.values, k)[0]
    binds = [dict(b) for b in keybind_defaults()["binds"]]
    follow = v("keybinds.workspaceStyle") == "moveFollow"
    for i in range(1, 10):
        key = f"code:{9 + i}"   # digit row by keycode, layout independent
        n = str(i)
        if follow:
            binds.append({"id": f"move-follow-{i}", "group": "workspaces", "keys": f"SUPER + {key}", "dispatch": f'hl.dsp.window.move({{ workspace = "{i}", follow = true }})', "description": f"Move window to workspace {i} and follow", "label": "Move window to workspace %1 and follow", "arg": n})
            binds.append({"id": f"workspace-{i}", "group": "workspaces", "keys": f"SUPER + ALT + {key}", "dispatch": f'hl.dsp.focus({{ workspace = "{i}" }})', "description": f"Workspace {i}", "label": "Workspace %1", "arg": n})
        else:
            binds.append({"id": f"workspace-{i}", "group": "workspaces", "keys": f"SUPER + {key}", "dispatch": f'hl.dsp.focus({{ workspace = "{i}" }})', "description": f"Workspace {i}", "label": "Workspace %1", "arg": n})
        binds.append({"id": f"move-to-{i}", "group": "workspaces", "keys": f"SUPER + SHIFT + {key}", "dispatch": f'hl.dsp.window.move({{ workspace = "{i}", follow = false }})', "description": f"Move window to workspace {i}", "label": "Move window to workspace %1", "arg": n})
    return binds


def action_text(b) -> str:
    return next((f"{k} {b[k]}" for k in ("ipc", "run", "dispatch") if k in b), "")


def live_keybinds():
    """The compositor's current binds as [(keys, description)]; [] without Hyprland."""
    code, out = run(["hyprctl", "binds", "-j"], timeout=3)
    try:
        rows = json.loads(out) if code == 0 else []
    except json.JSONDecodeError:
        return []
    live = []
    for r in rows if isinstance(rows, list) else []:
        if not r.get("key") or r.get("submap"):
            continue
        mods = [m for m in KEY_MODS if int(r.get("modmask", 0)) & MODMASK_BITS[m]]
        live.append((" + ".join(mods + [r["key"]]), r.get("description") or f"{r.get('dispatcher', '')} {r.get('arg', '')}".strip()))
    return live


def keybind_entries(cfg, live=None):
    """Everything the keybinding editor shows, in generation order: Bifrost's
    defaults, the user's own binds (keybinds.custom) and, read-only, binds from
    the compositor's own config (live, [(keys, description)]). Each entry:
    id, source (default|custom|external), group, label/arg/description,
    action, keys, defaultKeys, state (default|changed|off|groupOff|replaced|
    disabled|custom|external), active, conflicts (ids of other active entries
    on the same keys). effective_keybinds() generates exactly the active
    default and custom entries."""
    v = lambda k: deep_get(cfg.values, k)[0]
    enabled = v("keybinds.enabled") is not False
    overrides = v("keybinds.overrides") or {}
    disabled = {keys_id(k) for k in (v("keybinds.disabled") or [])}
    customs = []
    for i, line in enumerate(v("keybinds.custom") or []):
        c = parse_custom_bind(line)
        if c:
            customs.append({**c, "id": f"custom:{i}", "index": i})
    custom_keys = {keys_id(c["keys"]) for c in customs}
    defaults = default_keybinds(cfg)
    known = {action_text(b): b for b in keybind_defaults().get("actions", []) + defaults}
    entries = []
    for b in defaults:
        keys = overrides.get(b["id"], b["keys"])
        state = ("off" if not enabled else "groupOff" if v(f"keybinds.groups.{b['group']}") is False
                 else "off" if keys == "" else "disabled" if keys_id(keys) in disabled
                 else "replaced" if keys_id(keys) in custom_keys
                 else "changed" if b["id"] in overrides and keys_id(keys) != keys_id(b["keys"]) else "default")
        entries.append({**b, "source": "default", "label": b.get("label", b["description"]), "arg": b.get("arg", ""),
                        "action": action_text(b), "keys": keys, "defaultKeys": b["keys"], "state": state,
                        "active": state in ("default", "changed")})
    for c in customs:
        state = "off" if not enabled else "disabled" if keys_id(c["keys"]) in disabled else "custom"
        same = known.get(action_text(c), {})
        entries.append({**c, "source": "custom", "group": "custom", "label": same.get("label", same.get("description", action_text(c))), "arg": same.get("arg", ""),
                        "action": action_text(c), "defaultKeys": "", "state": state, "active": state == "custom"})
    # Binds Bifrost itself made (maybe from an older state) are not external.
    ours = {keys_id(e["keys"]) for e in entries if e["active"]}
    own_descriptions = {b["description"] for b in defaults} | {"custom"}
    for i, (keys, desc) in enumerate(live or []):
        if keys_id(keys) not in ours and desc not in own_descriptions:
            entries.append({"id": f"external:{i}", "source": "external", "group": "external", "label": desc, "arg": "",
                            "description": desc, "action": "", "keys": keys, "defaultKeys": "", "state": "external", "active": True})
    by_keys = {}
    for e in entries:
        if e["active"] and e["keys"]:
            by_keys.setdefault(keys_id(e["keys"]), []).append(e["id"])
    for e in entries:
        e["conflicts"] = [x for x in by_keys.get(keys_id(e["keys"]), []) if x != e["id"]] if e["active"] and e["keys"] else []
    return entries


def effective_keybinds(cfg):
    """The binds Bifrost installs, in order, after groups, digits, overrides, custom and disabled."""
    fields = ("id", "group", "keys", "ipc", "run", "dispatch", "locked", "repeating", "mouse", "description")
    return [{k: e[k] for k in fields if k in e} for e in keybind_entries(cfg) if e["active"] and e["source"] != "external"]


def keybind_conflicts(cfg, bind_id, keys, live=None):
    """Active entries other than bind_id that already use keys."""
    k = keys_id(keys)
    return [e for e in keybind_entries(cfg, live) if e["active"] and e["id"] != bind_id and e["keys"] and keys_id(e["keys"]) == k]


def keybind_edit(cfg, op, bind_id=None, keys=None, action=None, force=False, live=None):
    """Changes keybinds.overrides / custom / disabled for the editor.
    op: set (bind_id, keys) | off (bind_id) | reset (bind_id, or all) | add (keys, action).
    Unless force, a combination another active bind uses is refused with its
    conflicts; with force Bifrost's own conflicting binds are turned off (a
    default) or removed (your own), and one from the compositor's config is
    replaced (Bifrost unbinds a key before binding it). Returns a dict: ok,
    error, conflicts, keys."""
    v = lambda k: deep_get(cfg.values, k)[0]
    overrides = dict(v("keybinds.overrides") or {})
    custom = list(v("keybinds.custom") or [])
    disabled = list(v("keybinds.disabled") or [])
    entries = {e["id"]: e for e in keybind_entries(cfg, live)}
    if op in ("set", "off") and bind_id not in entries or bind_id and entries.get(bind_id, {}).get("source") == "external":
        return {"ok": False, "error": f"unknown or read-only binding '{bind_id}'"}
    canon = None
    if op in ("set", "add"):
        canon = canon_keys(keys)
        if not canon:
            return {"ok": False, "error": f"not a key combination: '{keys}'"}
        if op == "add":
            kind, _, arg = (action or "").strip().partition(" ")
            if kind not in ("ipc", "run", "dispatch") or not arg.strip():
                return {"ok": False, "error": "action must be 'ipc …', 'run …' or 'dispatch …'"}
        conflicts = keybind_conflicts(cfg, bind_id if op == "set" else None, canon, live)
        if conflicts and not force:
            return {"ok": False, "error": "conflict", "keys": canon, "conflicts": conflicts}
        removed = set()
        for c in conflicts:
            if c["source"] == "default":
                overrides[c["id"]] = ""
            elif c["source"] == "custom":
                removed.add(c["index"])
        custom = [x for i, x in enumerate(custom) if i not in removed]
        disabled = [d for d in disabled if keys_id(d) != keys_id(canon)]
        if op == "add":
            custom.append(f"{canon}: {action.strip()}")
        elif entries[bind_id]["source"] == "custom":
            idx = entries[bind_id]["index"]
            idx -= sum(1 for i in removed if i < idx)
            line = custom[idx]
            custom[idx] = canon + ":" + line.partition(":")[2]
        elif keys_id(canon) == keys_id(entries[bind_id]["defaultKeys"]):
            overrides.pop(bind_id, None)
        else:
            overrides[bind_id] = canon
    elif op == "off":
        e = entries[bind_id]
        if e["source"] == "custom":
            custom.pop(e["index"])
        else:
            overrides[bind_id] = ""
    elif op == "reset":
        targets = [e for e in entries.values() if e["source"] == "default" and (bind_id is None or e["id"] == bind_id)]
        if bind_id and not targets:
            return {"ok": False, "error": f"'{bind_id}' has no default"}
        for e in targets:
            overrides.pop(e["id"], None)
            disabled = [d for d in disabled if keys_id(d) != keys_id(e["defaultKeys"])]
    else:
        return {"ok": False, "error": f"unknown operation '{op}'"}
    cfg.set("keybinds.overrides", overrides)
    cfg.set("keybinds.custom", custom)
    cfg.set("keybinds.disabled", disabled)
    cfg.save()
    return {"ok": True, "keys": canon}


def keybind_lua(b) -> str:
    if "ipc" in b:
        action = f'hl.dsp.exec_cmd(bin .. {lua_str("bifrost-ipc " + b["ipc"])})'
    elif "run" in b:
        cmd = b["run"]
        action = f"hl.dsp.exec_cmd(bin .. {lua_str(cmd)})" if cmd.startswith("bifrost-") else f"hl.dsp.exec_cmd({lua_str(cmd)})"
    else:
        action = b["dispatch"]
    opts = [f"{k} = true" for k in ("locked", "repeating", "mouse") if b.get(k)]
    if b.get("description"):
        opts.append(f"description = {lua_str(b['description'])}")
    return f"bind({lua_str(b['keys'])}, {action}" + (f", {{ {', '.join(opts)} }})" if opts else ")")


# ── login screen (greetd greeter) ─────────────────────────────────────────
# The greeter runs as the "greeter" user, which cannot read ~/.config. `greeter
# sync` copies what it shows into its cache (created by
# greeter/install-greeter.sh, group greeter, setgid): a config.json with the
# look (Bifrost's own Config/Theme read it there), the wallpaper, your picture,
# the keyboard layout and the displays. No links into the home directory.
GREETER_SECTIONS = ("appearance", "materials", "motion", "clock", "lock", "wallpaper")


def greeter_cache() -> Path:
    return Path(os.environ.get("BIFROST_GREETER_CACHE") or "/var/cache/bifrost-greeter")


def greeter_status(prefix=None, conf=None, manager=None):
    import tomllib
    prefix = Path(prefix or "/usr/share/bifrost-greeter")
    conf = Path(conf or "/etc/greetd/config.toml")
    manager = Path(manager or "/etc/systemd/system/display-manager.service")
    launcher = prefix / "bin/bifrost-greeter"
    installed = launcher.is_file() and os.access(launcher, os.X_OK)
    helper = prefix / "greeter/manage-login.py"
    try:
        command = tomllib.loads(conf.read_text()).get("default_session", {}).get("command", "")
        argv = shlex.split(command)
    except (OSError, ValueError):
        argv = []
    theme_configured = bool(argv and argv[0] == str(launcher))
    display_manager = manager.resolve().stem if manager.exists() else "unknown"
    backups = list(conf.parent.glob(conf.name + ".before-bifrost-*"))
    ready = installed and helper.is_file() and bool(argv) and display_manager != "unknown"
    enabled = theme_configured and display_manager == "greetd"
    cache = greeter_cache()
    return {"ok": True, "installed": installed, "enabled": enabled,
            "displayManager": display_manager, "canEnable": ready,
            "canDisable": ready and bool(backups), "hasBackup": bool(backups),
            "cache": str(cache), "writable": cache.is_dir() and os.access(cache, os.W_OK)}


def greeter_switch(action):
    state = greeter_status()
    if action not in ("enable", "disable"):
        return {"ok": False, "error": "Invalid login screen action"}
    if not state["canEnable" if action == "enable" else "canDisable"]:
        return {"ok": False, "error": "Login screen switching is unavailable; install Bifrost for greetd first and keep its configuration backup."}
    try:
        result = subprocess.run(["pkexec", "/usr/share/bifrost-greeter/greeter/manage-login.py", action],
                                capture_output=True, text=True, timeout=110)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)}
    state = greeter_status()
    state["ok"] = result.returncode == 0 and state["enabled"] == (action == "enable")
    if not state["ok"]:
        state["error"] = (result.stderr + result.stdout).strip() or "Login screen change was not applied"
    return state


def greeter_keyboard():
    """The main keyboard's layout(s) as Hyprland has them now."""
    code, out = run(["hyprctl", "devices", "-j"], timeout=3)
    try:
        kbs = json.loads(out).get("keyboards", []) if code == 0 else []
    except (json.JSONDecodeError, AttributeError):
        kbs = []
    main = next((k for k in kbs if k.get("main")), kbs[0] if kbs else None)
    if not main:
        return {"layout": "us", "variant": "", "options": ""}
    return {"layout": main.get("layout") or "us", "variant": main.get("variant") or "", "options": main.get("options") or ""}


def write_file(path: Path, text: str):
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    tmp.chmod(0o644)
    tmp.replace(path)


def greeter_sync(cfg, cache=None, keyboard=None):
    import getpass
    import pwd
    import time
    cache = cache or greeter_cache()
    if not cache.is_dir() or not os.access(cache, os.W_OK):
        return {"ok": False, "error": f"{cache} is missing or not writable (run: sudo greeter/install-greeter.sh)"}
    v = lambda k: deep_get(cfg.values, k)[0]
    stored = cfg.doc.get("values", {})
    values = {k: copy.deepcopy(stored[k]) for k in GREETER_SECTIONS if k in stored}
    # Icon themes live in the home directory; the greeter uses Bifrost's own icons.
    values.get("appearance", {}).pop("icons", None)
    # Light or dark as it is now: the greeter has no system setting or location.
    if v("appearance.mode") not in ("light", "dark"):
        try:
            variant = json.loads((runtime_dir() / "appearance.json").read_text()).get("variant")
        except (OSError, json.JSONDecodeError):
            variant = None
        values.setdefault("appearance", {})["mode"] = variant if variant in ("light", "dark") else "dark"
    wallpaper = values.setdefault("wallpaper", {})
    wallpaper.pop("directory", None)
    for old in cache.glob("wallpaper.*"):
        old.unlink()
    src = Path(os.path.expanduser(v("wallpaper.path") or ""))
    if src.is_file():
        dst = cache / ("wallpaper" + src.suffix.lower())
        shutil.copyfile(src, dst)
        dst.chmod(0o644)
        wallpaper["path"] = str(dst)
    else:
        wallpaper["path"] = ""
    (cache / "config").mkdir(exist_ok=True)
    themes = cache / "config" / "themes"
    shutil.rmtree(themes, ignore_errors=True)
    user_themes = sorted((config_dir() / "themes").glob("*.json"))
    if user_themes:
        themes.mkdir()
        for t in user_themes:
            shutil.copyfile(t, themes / t.name)
            (themes / t.name).chmod(0o644)
    user = getpass.getuser()
    avatars = cache / "avatars"
    avatars.mkdir(exist_ok=True)
    for old in avatars.glob(f"{user}.*"):
        old.unlink()
    avatar = ""
    pic = Path(os.path.expanduser(v("greeter.avatar") or "~/.face"))
    if pic.is_file() and pic.stat().st_size <= 10 * 1024 * 1024:
        dst = avatars / f"{user}{pic.suffix.lower() or '.png'}"
        shutil.copyfile(pic, dst)
        dst.chmod(0o644)
        avatar = str(dst)
    write_file(cache / "config" / "config.json", json.dumps({"version": FORMAT_VERSION, "values": values}, indent=2) + "\n")
    try:
        meta = json.loads((cache / "greeter.json").read_text())
    except (OSError, json.JSONDecodeError):
        meta = {}
    try:
        real = pwd.getpwnam(user).pw_gecos.split(",")[0]
    except KeyError:
        real = ""
    users = [u for u in meta.get("users", []) if u.get("name") != user] + [{"name": user, "realName": real, "avatar": avatar}]
    kb = keyboard or greeter_keyboard()
    lang = os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    meta = {"version": 1, "syncedAt": int(time.time()), "users": users, "keyboard": kb, "language": lang}
    write_file(cache / "greeter.json", json.dumps(meta, indent=2, ensure_ascii=False) + "\n")
    (cache / "hypr").mkdir(exist_ok=True)
    lines = ["-- Written by bifrostctl greeter sync: the login screen's keyboard and displays.",
             f'hl.config({{ input = {{ kb_layout = {lua_str(kb["layout"])}, kb_variant = {lua_str(kb["variant"])}, kb_options = {lua_str(kb["options"])} }} }})']
    for name, o in (v("displays.outputs") or {}).items():
        lines.append(f'hl.monitor({{ output = {lua_str(name)}, mode = "{output_mode(o)}", position = "{o["x"]}x{o["y"]}", scale = {o["scale"]} }})')
    write_file(cache / "hypr" / "local.lua", "\n".join(lines) + "\n")
    return {"ok": True, "cache": str(cache), "user": user, "wallpaper": wallpaper["path"] != "", "avatar": avatar != "",
            "theme": v("appearance.theme"), "keyboard": kb, "outputs": sorted((v("displays.outputs") or {}).keys())}


def output_mode(output):
    # Hyprland 0.56 omits VRR from monitor-rule comparison. A tiny selector
    # bias forces reapplication when VRR changes, while selecting the same
    # advertised physical mode (Hyprland's matching tolerance is 1 Hz).
    refresh = float(output["refresh"]) + (0.01 if output.get("vrr") else -0.01)
    return f'{output["width"]}x{output["height"]}@{refresh:.5f}'


def blur_amount(x) -> float:
    """Background blur 0–100 (0 = off); tolerates the pre-v5 booleans."""
    if x is True or x is None:
        return 20
    if x is False:
        return 0
    return max(0, min(100, x))


# Bifrost's layer namespaces that get compositor blur (Glass & transparency).
BLUR_NAMESPACES = ("bar", "dock", "launcher", "power", "controlcenter", "notifications", "notificationcenter", "prompt", "osd", "overview")


def theme_chain(cfg):
    """Theme files from _base to the active theme (following "extends")."""
    theme_id = deep_get(cfg.values, "appearance.theme")[0] or "bifrost-graphite"
    chain, seen = [], set()
    while theme_id and theme_id not in seen:
        seen.add(theme_id)
        f = next((d / f"{theme_id}.json" for d in (config_dir() / "themes", REPO / "themes") if (d / f"{theme_id}.json").exists()), None)
        if not f:
            break
        t = json.loads(f.read_text())
        chain.insert(0, t)
        theme_id = t.get("extends")
    return chain


def window_radius(cfg):
    """Same explicit-or-theme rounding as Theme.windowRadius (not bar material)."""
    own = deep_get(cfg.values, "hyprland.rounding")[0]
    if own is not None:
        return max(0, int(own))
    radius = 0
    variant = effective_variant(cfg)
    for theme in theme_chain(cfg):
        for layer in (theme, theme.get("variants", {}).get(variant, {})):
            radius = layer.get("radius", {}).get("lg", radius)
    scale = deep_get(cfg.values, "appearance.radiusScale")[0]
    return max(0, math.floor(radius * (scale if scale is not None else 1) + 0.5))


def settings_radius(cfg) -> float:
    """Corner radius of the Settings window's glass as ThemeLogic resolves it:
    the theme material's radius token × radiusScale, capped to what Hyprland
    can clip a window to."""
    variant = effective_variant(cfg)
    radius, mats, glass = {}, {}, {}
    for t in theme_chain(cfg):
        for layer in (t, t.get("variants", {}).get(variant, {})):
            radius.update(layer.get("radius", {}))
            glass.update(layer.get("glass", {}))
            for k, m in layer.get("materials", {}).items():
                mats.setdefault(k, {}).update(m)
    m = mats.get("settings") or mats.get("panel") or {}
    r = m.get("radius", "@radius.xl")
    if isinstance(r, str) and r.startswith("@radius."):
        r = radius.get(r.split(".", 1)[1], 0)
    scale = deep_get(cfg.values, "appearance.radiusScale")[0]
    if isinstance(scale, (int, float)) and not isinstance(scale, bool):
        r = round(r * scale * 100) / 100
    return min(r, glass.get("windowRadiusMax", 20))


def generate_hypr(cfg) -> str:
    v = lambda k: deep_get(cfg.values, k)[0]
    lines = [
        "-- Generated by Bifrost (bifrostctl hypr generate). Do not edit: change",
        "-- Bifrost Settings (Keybindings, Hyprland, Displays) instead.",
        "-- Loaded from hyprland.lua by the installer's hook:",
        '--   dofile((os.getenv("XDG_CONFIG_HOME") or (os.getenv("HOME") .. "/.config")) .. "/bifrost/hypr/bifrost.lua")',
        "-- Safe to run again at runtime (hyprctl eval dofile): binds are unbound",
        "-- before binding and rules replace their previous versions.",
        "",
        f"local bin = {install_bin_lua()}",
        "_G.__bifrost = _G.__bifrost or { binds = {}, rules = {} }",
        "local state = _G.__bifrost",
        "",
        "-- Keys bound by the previous run of this file are released first, so",
        "-- switching a bind off takes effect without a Hyprland reload.",
        "for _, keys in ipairs(state.binds) do pcall(hl.unbind, keys) end",
        "state.binds = {}",
        "local function bind(keys, action, opts)",
        "\tpcall(hl.unbind, keys)",
        "\thl.bind(keys, action, opts)",
        "\ttable.insert(state.binds, keys)",
        "end",
        "",
        "local function replace_rule(name, make, rule)",
        "\tlocal old = state.rules[name]",
        "\tif old then pcall(function() old:set_enabled(false) end) end",
        "\tstate.rules[name] = make(rule)",
        "end",
        "local function layer_rule(name, rule) replace_rule(name, hl.layer_rule, rule) end",
        "local function window_rule(name, rule) replace_rule(name, hl.window_rule, rule) end",
        "",
        "-- Start the shell with every Hyprland. The session target can outlive a",
        "-- Hyprland that crashed on logout, and the shell's restarts without a",
        "-- compositor leave it failed, so the next login would not start it.",
        "if not state.startHook then",
        "\tstate.startHook = true",
        '\thl.on("hyprland.start", function()',
        '\t\thl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP; "',
        '\t\t\t.. "systemctl --user reset-failed bifrost.service; "',
        '\t\t\t.. "(systemctl --user is-active --quiet graphical-session.target || systemctl --user start bifrost-session.target) && systemctl --user start bifrost.service")',
        "\tend)",
        "end",
        "",
    ]
    glass_tokens = json.loads((REPO / "themes/_base.json").read_text())["glass"]
    # One blur for every Bifrost surface (Glass & transparency).
    strength = blur_amount(v("materials.blur"))
    blur_size = max(1, round(1 + strength * 0.39))
    blur_passes = 2 if strength < 10 else min(6, 2 + round((strength - 10) / 22.5))
    if v("hyprland.manage"):
        base = json.loads((REPO / "themes/_base.json").read_text())
        rounding = window_radius(cfg)
        pal = theme_palette(cfg)
        active = (pal.get("accent") or "#8FA8C8").lstrip("#").lower()
        inactive = (pal.get("surfaceRaised") or "#1E2126").lstrip("#").lower()
        accent = v(f"appearance.accent.{effective_variant(cfg)}")
        if accent:
            active = accent.lstrip("#").lower()
        if v("hyprland.activeBorderColor"):
            active = v("hyprland.activeBorderColor").lstrip("#").lower()
        if v("hyprland.inactiveBorderColor"):
            inactive = v("hyprland.inactiveBorderColor").lstrip("#").lower()
        shadow_base = base["elevation"]["mid"]
        shadow_range = max(1, round(shadow_base["blur"]))
        shadow_rgb = (pal.get("void") or "#000000").lstrip("#")
        shadow_alpha = round(min(1, shadow_base["opacity"]) * 255)
        shadow_colour = f"rgba({shadow_rgb}{shadow_alpha:02x})"
        lines += [
            "-- Appearance (hyprland.manage)",
            "hl.config({",
            f"\tgeneral = {{ gaps_in = {v('hyprland.gapsIn')}, gaps_out = {v('hyprland.gapsOut')}, border_size = {v('hyprland.borderSize')},",
            f'\t\tcol = {{ active_border = "rgb({active})", inactive_border = "rgb({inactive})" }} }},',
            f"\tdecoration = {{ rounding = {rounding}, active_opacity = 1, inactive_opacity = 1,",
            f"\t\tshadow = {{ enabled = true, range = {shadow_range}, render_power = 3, color = \"{shadow_colour}\", color_inactive = \"{shadow_colour}\" }},",
            f"\t\tblur = {{ enabled = {'true' if strength > 0 else 'false'}, size = {blur_size}, passes = {blur_passes} }} }},",
            "})",
            "",
        ]
    # Unnamed floating XWayland menus include transparent shadow margins.
    # Blurring those margins produces a large rounded rectangle around the menu.
    lines += [
        'local popup_rule = state.rules["bifrost-xwayland-menu-blur"]',
        'if popup_rule then popup_rule:set_enabled(false); state.rules["bifrost-xwayland-menu-blur"] = nil end',
    ]
    if v("hyprland.manage"):
        lines.append('window_rule("bifrost-xwayland-menu-blur", { match = { class = "^$", title = "^$", xwayland = true, float = true }, no_blur = true })')
    # Screen timeout (Settings → Power): input wakes the displays in the
    # compositor itself, so screens Bifrost turned off come back even if the
    # shell is not running.
    if (v("power.idle.screenOffMinutes") or 0) > 0:
        lines += ["-- Screen timeout (Settings → Power): any input turns the screens back on",
                  "hl.config({ misc = { key_press_enables_dpms = true, mouse_move_enables_dpms = true } })", ""]
    outputs = v("displays.outputs") or {}
    if outputs:
        lines.append("local apply_output = (function()\n" + (REPO / "shell/Compat/MonitorApply.lua").read_text() + "\nend)()")
        lines.append("-- Displays (Settings → System → Displays)")
        for name, o in outputs.items():
            lines.append(f'apply_output({{ output = {lua_str(name)}, mode = "{output_mode(o)}", position = "{o["x"]}x{o["y"]}", scale = {o["scale"]}, vrr = {1 if o.get("vrr") else 0}, bitdepth = {o.get("bitdepth", 8)}' + (f', cm = {lua_str(o["cm"])}' if o.get("cm") else "") + (f', sdrbrightness = {max(0.5, min(15, float(o["sdrBrightness"])))}' if "sdrBrightness" in o else "") + ' })')
        lines.append("")
    if v("hyprland.layerRules"):
        blur = str(strength > 0).lower()
        mask = glass_tokens.get("blurMaskShadowed", 0.12)
        lines += [
            "-- Bifrost surfaces: the shell animates them itself; background blur from",
            "-- Settings → Glass & transparency.",
            "for _, n in ipairs({ \"bifrost-blur\" }) do",
            "\tlocal r = state.rules[n]",
            "\tif r then pcall(function() r:set_enabled(false) end); state.rules[n] = nil end",
            "end",
            'layer_rule("bifrost-noanim", { match = { namespace = "^bifrost:.*" }, no_anim = true })',
        ]
        # A bar without a panel is only its widget boxes: they choose (bar.boxes.blur).
        boxes_only = v("bar.background") == "none" and v("bar.widgetStyle") in ("boxed", "grouped")
        for ns in BLUR_NAMESPACES:
            b = str(strength > 0 and v("bar.boxes.blur") is not False).lower() if ns == "bar" and boxes_only else blur
            lines.append(f'layer_rule("bifrost-blur-{ns}", {{ match = {{ namespace = "^bifrost:{ns}$" }}, blur = {b}, ignore_alpha = {mask:g}, blur_popups = {blur} }})')
        lines.append("")
    layout = json.loads((REPO / "themes/_base.json").read_text())["layout"]
    w, h = layout["settingsWidth"], layout["settingsHeight"]
    # The window is its glass: Hyprland clips it (and the blur behind it) to
    # the glass's corner radius.
    settings_rounding = round(settings_radius(cfg))
    lines += [
        "-- Bifrost's own app windows float, centred, like a settings dialog",
        f'window_rule("bifrost-settings", {{ match = {{ class = "^bifrost\\\\.settings$" }}, float = true, center = true, size = {{ "min({w}, monitor_w*0.9)", "min({h}, monitor_h*0.9)" }},'
        f' border_size = 0, no_shadow = true, rounding = {settings_rounding}, rounding_power = 2, no_blur = {str(strength <= 0).lower()} }})',
        "",
    ]
    import input_backend
    # Native compositor motion drives both keyboard transitions and 1:1 swipes.
    # Set both children too: existing per-leaf fade styles must not override slide.
    lines.append('hl.curve("bifrost_workspace", {type="bezier", points={{0.42,0},{0.58,1}}})')
    for leaf in ("workspaces", "workspacesIn", "workspacesOut"):
        lines.append('hl.animation({leaf='+lua_str(leaf)+', enabled=true, speed='+str(v("workspaces.transitionSpeed") or 4)+', bezier="bifrost_workspace", style="slide"})')
    lines.append("hl.config({ general = { resize_on_border = " + str(bool(v("input.resizeOnBorder"))).lower() + " } })")
    lines.append(input_backend.generate(v("input.devices") or {}, v("input.gestures") or {}, v("input.activeLayouts") or {}, gesture_actions()))
    binds = effective_keybinds(cfg)
    if binds:
        lines.append("-- Keybindings (hypr/keybinds.json + Settings → Keybindings)")
        lines += [keybind_lua(b) for b in binds]
        lines.append("")
    return "\n".join(lines)


def hypr_status(cfg):
    """Whether Bifrost's compositor settings are hooked in and current."""
    f = hypr_file()
    hl = Path(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")) / "hypr" / "hyprland.lua"
    hooked = hl.exists() and "bifrost/hypr/bifrost.lua" in hl.read_text()
    return {
        "file": str(f),
        "exists": f.exists(),
        "current": f.exists() and f.read_text() == generate_hypr(cfg),
        "hyprlandConfig": str(hl) if hl.exists() else None,
        "hooked": hooked,
        "running": bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")),
    }


def hypr_apply(cfg):
    """Writes bifrost.lua and runs it in the live Hyprland (idempotent).
    Returns (ok, message)."""
    path = hypr_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    text = generate_hypr(cfg)
    tmp = path.with_suffix(".lua.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True, f"wrote {path} (Hyprland not running here; applies on next start)"
    code, out = run(["hyprctl", "eval", f"dofile({lua_str(str(path))})"], timeout=10)
    ok = code == 0 and not out.strip().lower().startswith("error")
    return ok, f"wrote and applied {path}" if ok else f"wrote {path}; apply failed: {out.strip()}"


def verify_hypr(path: Path):
    """Runs Hyprland --verify-config on a throwaway wrapper that loads `path`."""
    if not shutil.which("Hyprland"):
        return False, "Hyprland not installed"
    with tempfile.TemporaryDirectory() as tmp:
        wrapper = Path(tmp) / "verify.lua"
        wrapper.write_text(f'__bifrost_verify = true\nhl.monitor({{ output = "", mode = "preferred", position = "0x0", scale = 1 }})\ndofile({lua_str(str(path))})\n')
        code, out = run(["Hyprland", "--verify-config", "--config", str(wrapper)], timeout=20)
    ok = code == 0 and "config ok" in out
    return ok, out.strip().splitlines()[-1] if out.strip() else ""


def production_checks(cfg):
    """Read-only checks before a switch. Returns [(status, name, detail)]."""
    rows = []
    f = hypr_file()
    if f.exists():
        ok, msg = verify_hypr(f)
        rows.append(("ok" if ok else "fail", "bifrost.lua", f"{f} ({'verifierad' if ok else msg})"))
        if f.read_text() != generate_hypr(cfg):
            rows.append(("warn", "bifrost.lua aktuell", "inställningarna har ändrats sedan filen skrevs — generera igen"))
    else:
        rows.append(("warn", "bifrost.lua", "inte genererad ännu (bifrostctl hypr generate --write)"))
    hl = Path(os.path.expanduser("~/.config/hypr/hyprland.lua"))
    if hl.exists():
        text = hl.read_text()
        rows.append(("info", "hyprland.lua laddar Bifrost", "ja" if "bifrost/hypr/bifrost.lua" in text else "nej (steg 3 i SWITCHOVER.md)"))
        rows.append(("info", "hyprland.lua laddar DMS-binds", "ja (tas bort vid bytet)" if 'require("dms.binds")' in text else "nej"))
    unit = Path(os.path.expanduser("~/.config/systemd/user/bifrost.service"))
    rows.append(("info", "bifrost.service installerad", "ja" if unit.exists() else "nej (steg 2 i SWITCHOVER.md)"))
    dms_active = run(["systemctl", "--user", "is-active", "dms.service"])[1].strip() == "active"
    rows.append(("info", "DMS körs", "ja — stoppas när bifrost.service startas (Conflicts=)" if dms_active else "nej"))
    pam = deep_get(cfg.values, "lock.pamService")[0] or "login"
    rows.append(("ok" if Path("/etc/pam.d", pam).exists() else "fail", "PAM-tjänst för låsskärmen", f"/etc/pam.d/{pam}"))
    wp = deep_get(cfg.values, "wallpaper.path")[0]
    rows.append(("ok" if wp and Path(os.path.expanduser(wp)).exists() else "warn", "Bakgrundsbild", wp or "ingen vald (svart bakgrund)"))
    pinned = deep_get(cfg.values, "dock.pinned")[0] or []
    rows.append(("info", "Fästa appar i docken", str(len(pinned)) + (" (import från DMS möjlig)" if not pinned else "")))
    rows.append(("info", "Greeter", "greetd med DMS-greetern påverkas inte av bytet"))
    return rows


