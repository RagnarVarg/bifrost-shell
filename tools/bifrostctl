DMS_WIDGETS = {
    "launcherButton": "launcher", "workspaceSwitcher": "workspaces", "focusedWindow": "activeWindow",
    "clock": "clock", "cpuUsage": "systemStats", "memUsage": "systemStats", "cpuTemp": "gpu", "gpuTemp": "gpu",
