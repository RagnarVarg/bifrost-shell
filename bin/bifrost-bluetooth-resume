#!/usr/bin/env bash
# Keeps Bluetooth powered after suspend (run by bifrost-bluetooth.service).
# On some machines the USB controller is reinitialised on resume ("xHC error in
# resume, Reinit"); a USB Bluetooth adapter then re-registers powered off and
# BlueZ's AutoEnable doesn't bring it back. Powers the adapter on at start and
# after every resume (logind PrepareForSleep false), retrying while it
# reappears.

power_on() {
    for _ in $(seq 1 30); do
        bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && return 0
        bluetoothctl power on >/dev/null 2>&1
        sleep 1
    done
    echo "could not power on Bluetooth" >&2
}

command -v bluetoothctl >/dev/null || { echo "bluetoothctl not found" >&2; exit 0; }

power_on

gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 |
    while read -r line; do
        case "$line" in
            *PrepareForSleep*false*) echo "resumed: powering on Bluetooth"; power_on ;;
        esac
    done
