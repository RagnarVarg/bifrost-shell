#!/usr/bin/env bash
# Calls the running Bifrost shell: bifrost-ipc <target> <function> [args…]
# e.g. bifrost-ipc launcher toggle. The install is found from this script's
# own location (it may be symlinked from ~/.local/bin).
set -e
# ~/.local/bin/<cmd> links to <install>/bin/<cmd>: follow that one link only,
# so the install path stays as installed (even when it is itself a symlink).
self="$0"; [[ -L "$self" ]] && self="$(readlink "$self")"
dir="$(cd "$(dirname "$self")/.." && pwd)"
exec qs ipc -p "$dir/shell" call "$@"
